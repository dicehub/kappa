---
import CodeBlock from "../../../components/CodeBlock.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import TimeseriesDocsDemo from "../../../components/TimeseriesDocsDemo.vue";
import {
  areaCode,
  barsCode,
  gapsCode,
  timeseriesCode,
  timeseriesInstallCode,
  timeseriesMethods,
  timeseriesProps,
  timeseriesStatesCode,
  utcCode,
} from "../../../data/timeseries-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/docs-components.css";

const description = "Build polished dashboard trends with opinionated ECharts defaults.";
const currentPath = "/docs/charts/timeseries";
const examples = [
  { id: "bars", title: "Counts as Bars", description: "Use bars for discrete values collected in fixed time buckets.", variant: "bars", code: barsCode },
  { id: "gaps", title: "Missing Data", description: "Keep missing intervals visible. Opt into connectNulls only when joining the gap is truthful.", variant: "gaps", code: gapsCode },
  { id: "stacked-area", title: "Stacked Area", description: "Show how related series contribute to a total without exposing ECharts option plumbing.", variant: "area", code: areaCode },
  { id: "time-zone", title: "UTC and Locale", description: "Choose UTC or browser-local labels and an explicit display locale.", variant: "utc", code: utcCode },
  { id: "states", title: "Data States", description: "Keep loading, empty, and error behavior inside the same stable frame.", variant: "states", code: timeseriesStatesCode },
] as const;
---

<DocsLayout title="Timeseries" description={description}>
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-actions"><CopyPageControls client:only="vue" align="center" /></div>
          <div class="docs-page-header__title-row">
            <h1>Timeseries</h1>
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-actions"><CopyPageControls client:only="vue" /></div>
              <DocsPageNavigation currentPath={currentPath} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">{description}</p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview"><TimeseriesDocsDemo client:only="vue" variant="preview" /></div>
            <CodeBlock code={timeseriesCode} lang="vue" collapsible revealId="timeseries-preview-code" />
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>
          <p>
            <code>TimeseriesChart</code> uses the optional ECharts peer dependency. Import it from its isolated component path so applications that do not draw charts do not load ECharts.
          </p>
          <CodeBlock code={timeseriesInstallCode} lang="bash" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            Supply timestamp and value pairs inside each named series. Timestamps use Unix milliseconds. Replace the series reference, or update <code>revision</code> after a controlled in-place mutation.
          </p>
          <CodeBlock code={timeseriesCode} lang="vue" collapsible revealId="timeseries-usage-code" />
        </section>

        <section id="composition" class="docs-section">
          <h2><a class="docs-section-anchor" href="#composition">Composition</a></h2>
          <p>
            This component configures the existing ECharts <code>Chart</code> host for dashboard time data. It owns the grid, axes, safe rich-text tooltip, legend, theme, and motion defaults. Use the lower-level <code>Chart</code> component when the visualization needs a different ECharts shape.
          </p>
          <ul>
            <li>Set a chart-wide <code>type</code> and <code>curve</code>, or override them on one series.</li>
            <li>Use <code>null</code> for a missing sample. Set <code>connectNulls</code> only when joining the gap is valid.</li>
            <li>Use the toolbar, loading, empty, error, and footer slots for product-specific content.</li>
            <li>Use <code>valueFormatter</code> for units. Kappa keeps the standard tooltip in ECharts rich-text mode.</li>
          </ul>
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>
          {examples.map((example) => (
            <>
              <h3 id={example.id}><a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a></h3>
              <p>{example.description}</p>
              <div class="docs-component-example">
                <div class="docs-component-preview"><TimeseriesDocsDemo client:only="vue" variant={example.variant} /></div>
                <CodeBlock code={example.code} lang="vue" collapsible revealId={`timeseries-${example.id}-code`} />
              </div>
            </>
          ))}
        </section>

        <section id="performance" class="docs-section">
          <h2><a class="docs-section-anchor" href="#performance">Performance</a></h2>
          <p>
            Use <code>TimeseriesChart</code> for normal dashboard ranges and visual quality. For 100,000 or more samples, sustained live telemetry, or scientific X/Y data, use <a href="/docs/charts#xy-plot"><code>XYPlot</code></a>. Kappa does not switch engines at runtime.
          </p>
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <ul>
            <li><code>ariaLabel</code> names the graphic. <code>ariaDescription</code> explains the range, units, series, and main trend.</li>
            <li>The pointer tooltip is supplementary. Put its essential meaning in the accessible description or a linked data table.</li>
            <li>Reduced-motion preferences turn off chart animation.</li>
            <li>Do not identify a series by color alone. Keep the legend or another visible label.</li>
          </ul>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>
          <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{timeseriesProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          <h3 id="methods"><a class="docs-section-anchor" href="#methods">Exposed Methods</a></h3>
          <div class="docs-api-table"><table><thead><tr><th>Method</th><th>Description</th></tr></thead><tbody>{timeseriesMethods.map((method) => <tr><td><code>{method.name}</code></td><td>{method.description}</td></tr>)}</tbody></table></div>
          <p>
            Import the component and its public types from <code>@dicehub/kappa/components/timeseries-chart</code>. The module exports <code>TimeseriesChart</code>, <code>TimeseriesChartProps</code>, <code>TimeseriesChartSeries</code>, and <code>TimeseriesChartApi</code>.
          </p>
        </section>

        <DocsPageNavigation currentPath={currentPath} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li><a href="#installation" data-toc-link="installation">Installation</a></li>
            <li><a href="#usage" data-toc-link="usage">Usage</a></li>
            <li><a href="#composition" data-toc-link="composition">Composition</a></li>
            <li><a href="#examples" data-toc-link="examples">Examples</a><ul>{examples.map((example) => <li><a href={`#${example.id}`} data-toc-link={example.id}>{example.title}</a></li>)}</ul></li>
            <li><a href="#performance" data-toc-link="performance">Performance</a></li>
            <li><a href="#accessibility" data-toc-link="accessibility">Accessibility</a></li>
            <li><a href="#api-reference" data-toc-link="api-reference">API Reference</a><ul><li><a href="#methods" data-toc-link="methods">Exposed Methods</a></li></ul></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
