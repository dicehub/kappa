---
import CardDocsDemo from "../../../components/CardDocsDemo.vue";
import CodeBlock from "../../../components/CodeBlock.astro";
import CompositionTree from "../../../components/CompositionTree.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import {
  barrelCode,
  dataSlots,
  examples,
  exportsList,
  granularCode,
  layeredParts,
  previewCode,
  rootProps,
  standardParts,
  usageCode,
} from "../../../data/card-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/docs-components.css";

const currentPath = "/docs/components/card";
const description = "Groups related content, context, and actions in one clear surface.";
---

<DocsLayout title="Card" description={description}>
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-actions">
            <CopyPageControls client:only="vue" align="center" />
          </div>
          <div class="docs-page-header__title-row">
            <h1>Card</h1>
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-actions">
                <CopyPageControls client:only="vue" />
              </div>
              <DocsPageNavigation currentPath={currentPath} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">{description}</p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview">
              <CardDocsDemo client:load variant="preview" />
            </div>
            <CodeBlock code={previewCode} lang="vue" collapsible revealId="card-preview-code" />
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>
          <p>
            Card is part of the main Kappa package. It uses native semantic elements and adds no
            state-machine dependency.
          </p>
          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={barrelCode} lang="javascript" />
          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={granularCode} lang="javascript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            Build a standard surface with Header, Content, and Footer. Place Action inside Header
            when the card needs a compact control or status.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--compact">
              <CardDocsDemo client:load variant="usage" />
            </div>
            <CodeBlock code={usageCode} lang="vue" collapsible revealId="card-usage-code" />
          </div>
        </section>

        <section id="composition" class="docs-section">
          <h2><a class="docs-section-anchor" href="#composition">Composition</a></h2>
          <CompositionTree component="card" />
          <p>
            The standard parts provide a header, content, and footer structure.
            Secondary and Primary provide a layered composition. Ark UI has no static Card primitive, so Kappa owns this native
            presentation and its semantic element choices.
          </p>
          <ul>
            <li>Use the standard parts for most content, forms, status, and actions.</li>
            <li>Use Secondary followed by Primary only when the layered visual hierarchy is useful.</li>
            <li>Use one heading element that fits the page outline. Card.Title defaults to <code>h3</code>.</li>
            <li>Do not nest Cards to create spacing. Use Grid or another layout container.</li>
          </ul>
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>
          {
            examples.map((example) => (
              <>
                <h3 id={example.id}>
                  <a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a>
                </h3>
                <p>{example.description}</p>
                <div class="docs-component-example">
                  <div class="docs-component-preview">
                    <CardDocsDemo client:load variant={example.variant} />
                  </div>
                  <CodeBlock
                    code={example.code}
                    lang="vue"
                    collapsible
                    revealId={`card-${example.id}-code`}
                  />
                </div>
              </>
            ))
          }
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <ul>
            <li>Card adds no widget role or keyboard behavior.</li>
            <li>Choose article, section, aside, header, and footer only when the content meets native HTML sectioning rules.</li>
            <li>Use <code>as="form"</code> when one Card contains one form. Do not nest forms.</li>
            <li>Use <code>as="a"</code> only when the complete surface has one target. Do not place other controls inside that anchor.</li>
            <li>Anchor surfaces keep a visible focus indicator and a forced-colors boundary.</li>
            <li>HTML, ARIA, data attributes, and event listeners pass to the selected native element.</li>
          </ul>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>
          <div class="docs-api-group">
            <h3 id="card-api"><a class="docs-section-anchor" href="#card-api">Card</a></h3>
            <p>Outer surface for standard, layered, or direct content.</p>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{rootProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="standard-parts"><a class="docs-section-anchor" href="#standard-parts">Standard Parts</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Part</th><th>Supported <code>as</code></th><th>Default</th><th>Description</th></tr></thead><tbody>{standardParts.map((part) => <tr><td><code>{part.name}</code></td><td><code>{part.element}</code></td><td><code>{part.defaultValue}</code></td><td>{part.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="layered-parts"><a class="docs-section-anchor" href="#layered-parts">Layered Parts</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Part</th><th>Supported <code>as</code></th><th>Default</th><th>Description</th></tr></thead><tbody>{layeredParts.map((part) => <tr><td><code>{part.name}</code></td><td><code>{part.element}</code></td><td><code>{part.defaultValue}</code></td><td>{part.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="data-slots"><a class="docs-section-anchor" href="#data-slots">Data Slots</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Slot</th><th>Description</th></tr></thead><tbody>{dataSlots.map(([name, slotDescription]) => <tr><td><code>{name}</code></td><td>{slotDescription}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="exports"><a class="docs-section-anchor" href="#exports">Exports</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Export</th><th>Description</th></tr></thead><tbody>{exportsList.map((item) => <tr><td><code>{item.name}</code></td><td>{item.description}</td></tr>)}</tbody></table></div>
          </div>
        </section>

        <DocsPageNavigation currentPath={currentPath} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li><a href="#installation" data-toc-link="installation">Installation</a><ul><li><a href="#barrel" data-toc-link="barrel">Barrel</a></li><li><a href="#granular" data-toc-link="granular">Granular</a></li></ul></li>
            <li><a href="#usage" data-toc-link="usage">Usage</a></li>
            <li><a href="#composition" data-toc-link="composition">Composition</a></li>
            <li><a href="#examples" data-toc-link="examples">Examples</a><ul>{examples.map((example) => <li><a href={`#${example.id}`} data-toc-link={example.id}>{example.title}</a></li>)}</ul></li>
            <li><a href="#accessibility" data-toc-link="accessibility">Accessibility</a></li>
            <li><a href="#api-reference" data-toc-link="api-reference">API Reference</a><ul><li><a href="#card-api" data-toc-link="card-api">Card</a></li><li><a href="#standard-parts" data-toc-link="standard-parts">Standard Parts</a></li><li><a href="#layered-parts" data-toc-link="layered-parts">Layered Parts</a></li><li><a href="#data-slots" data-toc-link="data-slots">Data Slots</a></li><li><a href="#exports" data-toc-link="exports">Exports</a></li></ul></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
