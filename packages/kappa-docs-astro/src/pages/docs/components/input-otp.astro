---
import ArkUiDocsLink from "../../../components/ArkUiDocsLink.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import CompositionTree from "../../../components/CompositionTree.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import InputOtpDocsDemo from "../../../components/InputOtpDocsDemo.vue";
import {
  barrelCode,
  blurCode,
  controlledCode,
  dataAttributes,
  events,
  exportsList,
  granularCode,
  maskCode,
  parts,
  patternCode,
  previewCode,
  providerCode,
  rootProps,
  statesCode,
  usageCode,
} from "../../../data/input-otp-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/docs-components.css";

const currentPath = "/docs/components/input-otp";
const description = "Collects a short verification code with accessible, machine-backed cells.";

const examples = [
  {
    id: "pattern",
    title: "Pattern and Placeholder",
    description: "Restrict each cell to numeric input and choose a quiet placeholder glyph.",
    variant: "pattern",
    code: patternCode,
  },
  {
    id: "mask",
    title: "Mask",
    description: "Use password-style masking when the code must not remain visible.",
    variant: "mask",
    code: maskCode,
  },
  {
    id: "states",
    title: "Disabled and Invalid",
    description: "Use the root state props to present validation and unavailable controls.",
    variant: "states",
    code: statesCode,
  },
  {
    id: "blur-on-complete",
    title: "Blur on Complete",
    description: "Move focus away from the final cell and handle valueComplete when the code is ready.",
    variant: "blur",
    code: blurCode,
  },
  {
    id: "controlled",
    title: "Controlled Value",
    description: "Keep the six-cell array in application state with v-model and value events.",
    variant: "controlled",
    code: controlledCode,
  },
] as const;
---

<DocsLayout title="Input OTP" description={description}>
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-actions">
            <CopyPageControls client:only="vue" align="center" />
          </div>
          <div class="docs-page-header__title-row">
            <h1>Input OTP</h1>
            <ArkUiDocsLink />
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-actions"><CopyPageControls client:only="vue" /></div>
              <DocsPageNavigation currentPath={currentPath} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">{description}</p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview"><InputOtpDocsDemo client:load variant="preview" /></div>
            <CodeBlock code={previewCode} lang="vue" collapsible revealId="input-otp-preview-code" />
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>
          <p>
            Input OTP is part of the main Kappa package. Kappa wraps the Ark UI Vue pin-input
            primitive and adds component names, tokens, cell geometry, and state styling.
          </p>
          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={barrelCode} lang="javascript" />
          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={granularCode} lang="javascript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            Set <code>count</code> for stable six-cell output, then render one indexed
            <code>InputOtp.Input</code> for every cell. Include <code>HiddenInput</code> when the value
            must submit with a native form. Set <code>otp</code> to enable one-time-code autocomplete.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><InputOtpDocsDemo client:load variant="usage" /></div>
            <CodeBlock code={usageCode} lang="vue" collapsible revealId="input-otp-usage-code" />
          </div>
        </section>

        <section id="composition" class="docs-section">
          <h2><a class="docs-section-anchor" href="#composition">Composition</a></h2>
          <CompositionTree component="inputOtp" />
          <p>
            Ark UI owns focus movement, paste handling, validation, hidden form input, and
            controlled/uncontrolled state. Kappa exposes the same machine through an InputOtp
            compound namespace and gives each part a stable Kappa slot and token-based style.
          </p>
          <ul>
            <li><code>Root</code> owns the pin-input machine and emits <code>valueChange</code>, <code>valueComplete</code>, <code>valueInvalid</code>, and <code>update:modelValue</code>.</li>
            <li><code>Control</code> lays out indexed cells. Render one <code>Input</code> per index from <code>0</code> to <code>count - 1</code>.</li>
            <li><code>HiddenInput</code> is visually hidden and keeps native <code>name</code>, <code>required</code>, and form behavior.</li>
            <li><code>Context</code> exposes the Ark API to a scoped slot. <code>RootProvider</code> accepts an API created with <code>usePinInput</code>.</li>
          </ul>
          <div class="docs-component-example">
            <CodeBlock code={providerCode} lang="vue" collapsible revealId="input-otp-provider-code" />
          </div>
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>
          {
            examples.map((example) => (
              <>
                <h3 id={example.id}><a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a></h3>
                <p>{example.description}</p>
                <div class="docs-component-example">
                  <div class="docs-component-preview"><InputOtpDocsDemo client:load variant={example.variant} /></div>
                  <CodeBlock code={example.code} lang="vue" collapsible revealId={`input-otp-${example.id}-code`} />
                </div>
              </>
            ))
          }
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <ul>
            <li>Give the root a visible <code>Label</code> or an explicit <code>aria-label</code>.</li>
            <li>Each cell receives an accessible position label from Ark UI. Keep the cell order and indexes stable.</li>
            <li>Arrow keys move between cells. Backspace clears and moves back; paste distributes valid characters across cells.</li>
            <li><code>otp</code> enables one-time-code autocomplete. Use <code>type</code> and <code>pattern</code> to constrain accepted values.</li>
            <li><code>invalid</code>, <code>disabled</code>, and <code>readOnly</code> are passed to Ark UI and reflected on root and cell state attributes.</li>
            <li>Use <code>blurOnComplete</code> when the next step should receive focus after a valid code. Handle <code>valueComplete</code> for submission or verification.</li>
            <li>Input cells keep visible focus in both themes, reduced-motion mode, and forced-color mode.</li>
          </ul>
          <p>
            See the <a href="https://ark-ui.com/docs/components/pin-input">official Ark UI Pin Input documentation</a>
            for the underlying machine behavior and accessibility contract.
          </p>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>
          <div class="docs-api-group">
            <h3 id="root-api"><a class="docs-section-anchor" href="#root-api">InputOtp.Root</a></h3>
            <p>The root accepts Ark UI pin-input props plus Kappa's visual <code>size</code>.</p>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{rootProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="parts-api"><a class="docs-section-anchor" href="#parts-api">Parts</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Part</th><th>Element</th><th>Description</th></tr></thead><tbody>{parts.map((part) => <tr><td><code>InputOtp.{part.name}</code></td><td><code>{part.element}</code></td><td>{part.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="events-api"><a class="docs-section-anchor" href="#events-api">Events</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Event</th><th>Payload</th><th>Description</th></tr></thead><tbody>{events.map((event) => <tr><td><code>{event.name}</code></td><td><code>{event.payload}</code></td><td>{event.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="data-attributes"><a class="docs-section-anchor" href="#data-attributes">Data Attributes</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Attribute</th><th>Value</th><th>Description</th></tr></thead><tbody>{dataAttributes.map((attribute) => <tr><td><code>{attribute.name}</code></td><td><code>{attribute.value}</code></td><td>{attribute.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="exports"><a class="docs-section-anchor" href="#exports">Exports</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Export</th><th>Description</th></tr></thead><tbody>{exportsList.map((item) => <tr><td><code>{item.name}</code></td><td>{item.description}</td></tr>)}</tbody></table></div>
          </div>
        </section>

        <DocsPageNavigation currentPath={currentPath} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li><a href="#installation" data-toc-link="installation">Installation</a><ul><li><a href="#barrel" data-toc-link="barrel">Barrel</a></li><li><a href="#granular" data-toc-link="granular">Granular</a></li></ul></li>
            <li><a href="#usage" data-toc-link="usage">Usage</a></li>
            <li><a href="#composition" data-toc-link="composition">Composition</a></li>
            <li><a href="#examples" data-toc-link="examples">Examples</a><ul>{examples.map((example) => <li><a href={`#${example.id}`} data-toc-link={example.id}>{example.title}</a></li>)}</ul></li>
            <li><a href="#accessibility" data-toc-link="accessibility">Accessibility</a></li>
            <li><a href="#api-reference" data-toc-link="api-reference">API Reference</a><ul><li><a href="#root-api" data-toc-link="root-api">InputOtp.Root</a></li><li><a href="#parts-api" data-toc-link="parts-api">Parts</a></li><li><a href="#events-api" data-toc-link="events-api">Events</a></li><li><a href="#data-attributes" data-toc-link="data-attributes">Data Attributes</a></li><li><a href="#exports" data-toc-link="exports">Exports</a></li></ul></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
