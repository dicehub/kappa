---
import ArkUiDocsLink from "../../../components/ArkUiDocsLink.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import CompositionTree from "../../../components/CompositionTree.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import TagInputDocsDemo from "../../../components/TagInputDocsDemo.vue";
import {
  barrelCode,
  controlledCode,
  dataAttributes,
  events,
  exportsList,
  granularCode,
  parts,
  pasteCode,
  previewCode,
  providerCode,
  rootProps,
  sizesCode,
  statesCode,
  usageCode,
} from "../../../data/tag-input-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/docs-components.css";

const currentPath = "/docs/components/tag-input";
const description = "Collects removable text values with accessible keyboard, paste, edit, and form behavior.";

const examples = [
  {
    id: "controlled",
    title: "Controlled Value",
    description: "Keep the tag array in application state with v-model.",
    variant: "controlled",
    code: controlledCode,
  },
  {
    id: "paste-validation",
    title: "Paste, Validation, and Limit",
    description: "Split pasted text, normalize each value, validate its format, and enforce a maximum count.",
    variant: "paste",
    code: pasteCode,
  },
  {
    id: "sizes",
    title: "Sizes",
    description: "Match tag density to compact tools, forms, and larger application surfaces.",
    variant: "sizes",
    code: sizesCode,
  },
  {
    id: "states",
    title: "Invalid, Read-only, and Disabled",
    description: "Pass state through the root so every machine part stays synchronized.",
    variant: "states",
    code: statesCode,
  },
] as const;
---

<DocsLayout title="Tag Input" description={description}>
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-actions">
            <CopyPageControls client:only="vue" align="center" />
          </div>
          <div class="docs-page-header__title-row">
            <h1>Tag Input</h1>
            <ArkUiDocsLink />
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-actions"><CopyPageControls client:only="vue" /></div>
              <DocsPageNavigation currentPath={currentPath} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">{description}</p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview"><TagInputDocsDemo client:load variant="preview" /></div>
            <CodeBlock code={previewCode} lang="vue" collapsible revealId="tag-input-preview-code" />
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>
          <p>
            Tag Input is part of the main Kappa package. Kappa wraps the Ark UI Vue tags-input
            primitive and adds the public namespace, dense sizes, default action icons, and semantic-token styles.
          </p>
          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={barrelCode} lang="javascript" />
          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={granularCode} lang="javascript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            Render the current values from <code>TagInput.Context</code>. Each <code>Item</code> needs
            its value and stable index. Include <code>ItemInput</code> to support tag editing and
            <code>HiddenInput</code> for native form submission.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><TagInputDocsDemo client:load variant="usage" /></div>
            <CodeBlock code={usageCode} lang="vue" collapsible revealId="tag-input-usage-code" />
          </div>
        </section>

        <section id="composition" class="docs-section">
          <h2><a class="docs-section-anchor" href="#composition">Composition</a></h2>
          <CompositionTree component="tagInput" />
          <p>
            Ark UI owns tag creation, removal, editing, focus movement, paste parsing, validation,
            announcements, and controlled or uncontrolled state. Kappa keeps these parts open for custom content.
          </p>
          <ul>
            <li><code>Root</code> owns state. <code>RootProvider</code> accepts a machine from <code>useTagsInput</code>.</li>
            <li><code>Control</code> wraps all visible values, the entry input, and the optional clear action.</li>
            <li><code>ItemPreview</code> contains display text and its delete action. <code>ItemInput</code> appears in edit mode.</li>
            <li><code>Context</code> exposes the values and root API. <code>ItemContext</code> exposes item state.</li>
          </ul>
          <div class="docs-component-example">
            <CodeBlock code={providerCode} lang="vue" collapsible revealId="tag-input-provider-code" />
          </div>
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>
          {
            examples.map((example) => (
              <>
                <h3 id={example.id}><a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a></h3>
                <p>{example.description}</p>
                <div class="docs-component-example">
                  <div class="docs-component-preview"><TagInputDocsDemo client:load variant={example.variant} /></div>
                  <CodeBlock code={example.code} lang="vue" collapsible revealId={`tag-input-${example.id}-code`} />
                </div>
              </>
            ))
          }
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <ul>
            <li>Use a visible <code>Label</code>. Add a distinct accessible name to the entry <code>Input</code> when needed.</li>
            <li><kbd>Enter</kbd> or the delimiter adds a tag. <kbd>Backspace</kbd> selects and then removes the previous tag.</li>
            <li>Arrow keys move the tag highlight. <kbd>Delete</kbd> removes the highlighted tag.</li>
            <li><kbd>Enter</kbd> or double-click edits a tag when <code>editable</code> is enabled. <kbd>Escape</kbd> cancels the edit.</li>
            <li>Delete and clear actions receive localized names from Ark UI. Override <code>translations</code> for another language.</li>
            <li>Invalid, disabled, read-only, focus, and highlighted states remain visible in both themes and forced colors.</li>
          </ul>
          <p>
            See the <a href="https://ark-ui.com/docs/components/tags-input">official Ark UI Tags Input documentation</a>
            for the underlying machine behavior and accessibility contract.
          </p>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>
          <div class="docs-api-group">
            <h3 id="root-api"><a class="docs-section-anchor" href="#root-api">TagInput.Root</a></h3>
            <p>The root accepts Ark UI tags-input props plus Kappa's visual <code>size</code>.</p>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{rootProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="parts-api"><a class="docs-section-anchor" href="#parts-api">Parts</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Part</th><th>Element</th><th>Description</th></tr></thead><tbody>{parts.map((part) => <tr><td><code>TagInput.{part.name}</code></td><td><code>{part.element}</code></td><td>{part.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="events-api"><a class="docs-section-anchor" href="#events-api">Events</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Event</th><th>Payload</th><th>Description</th></tr></thead><tbody>{events.map((event) => <tr><td><code>{event.name}</code></td><td><code>{event.payload}</code></td><td>{event.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="data-attributes"><a class="docs-section-anchor" href="#data-attributes">Data Attributes</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Attribute</th><th>Value</th><th>Description</th></tr></thead><tbody>{dataAttributes.map((attribute) => <tr><td><code>{attribute.name}</code></td><td><code>{attribute.value}</code></td><td>{attribute.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="exports"><a class="docs-section-anchor" href="#exports">Exports</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Export</th><th>Description</th></tr></thead><tbody>{exportsList.map((item) => <tr><td><code>{item.name}</code></td><td>{item.description}</td></tr>)}</tbody></table></div>
          </div>
        </section>

        <DocsPageNavigation currentPath={currentPath} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li><a href="#installation" data-toc-link="installation">Installation</a><ul><li><a href="#barrel" data-toc-link="barrel">Barrel</a></li><li><a href="#granular" data-toc-link="granular">Granular</a></li></ul></li>
            <li><a href="#usage" data-toc-link="usage">Usage</a></li>
            <li><a href="#composition" data-toc-link="composition">Composition</a></li>
            <li><a href="#examples" data-toc-link="examples">Examples</a><ul>{examples.map((example) => <li><a href={`#${example.id}`} data-toc-link={example.id}>{example.title}</a></li>)}</ul></li>
            <li><a href="#accessibility" data-toc-link="accessibility">Accessibility</a></li>
            <li><a href="#api-reference" data-toc-link="api-reference">API Reference</a><ul><li><a href="#root-api" data-toc-link="root-api">TagInput.Root</a></li><li><a href="#parts-api" data-toc-link="parts-api">Parts</a></li><li><a href="#events-api" data-toc-link="events-api">Events</a></li><li><a href="#data-attributes" data-toc-link="data-attributes">Data Attributes</a></li><li><a href="#exports" data-toc-link="exports">Exports</a></li></ul></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
