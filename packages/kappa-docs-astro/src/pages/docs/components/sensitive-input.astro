---
import CodeBlock from "../../../components/CodeBlock.astro";
import CompositionTree from "../../../components/CompositionTree.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import SensitiveInputDocsDemo from "../../../components/SensitiveInputDocsDemo.vue";
import {
  barrelCode,
  controlledCode,
  dataAttributes,
  events,
  exportsList,
  granularCode,
  interactionCode,
  parts,
  previewCode,
  rootProps,
  sizesCode,
  statesCode,
  usageCode,
} from "../../../data/sensitive-input-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/docs-components.css";

const currentPath = "/docs/components/sensitive-input";
const description = "Keeps secrets masked until a person chooses to reveal or copy them.";

const examples = [
  {
    id: "sizes",
    title: "Sizes",
    description: "Use xs, sm, base, or lg to match nearby Kappa controls.",
    variant: "sizes",
    code: sizesCode,
  },
  {
    id: "controlled",
    title: "Controlled Value",
    description: "Use v-model when the application owns the sensitive value.",
    variant: "controlled",
    code: controlledCode,
  },
  {
    id: "states",
    title: "Form States",
    description: "Pair invalid, disabled, and read-only states with clear form messaging.",
    variant: "states",
    code: statesCode,
  },
  {
    id: "interaction",
    title: "Reveal and Copy",
    description: "Masked values reveal from the control or keyboard, and copy feedback is announced.",
    variant: "interaction",
    code: interactionCode,
  },
] as const;
---

<DocsLayout title="Sensitive Input" description={description}>
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-actions">
            <CopyPageControls client:only="vue" align="center" />
          </div>
          <div class="docs-page-header__title-row">
            <h1>Sensitive Input</h1>
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-actions"><CopyPageControls client:only="vue" /></div>
              <DocsPageNavigation currentPath={currentPath} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">{description}</p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview"><SensitiveInputDocsDemo client:load variant="preview" /></div>
            <CodeBlock code={previewCode} lang="vue" collapsible revealId="sensitive-input-preview-code" />
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>
          <p>
            Sensitive Input is part of the main Kappa package. It renders a native input and uses
            the Clipboard API when available, with a browser fallback for older contexts.
          </p>
          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={barrelCode} lang="javascript" />
          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={granularCode} lang="javascript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            Give the control a visible <code>label</code> or an explicit accessible name. Values start
            masked when present. Hover or focus the control to see <em>Click to reveal</em> and the
            copy action; the eye action stays available. Leaving the control masks it again. Copy
            always writes the original value.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><SensitiveInputDocsDemo client:load variant="usage" /></div>
            <CodeBlock code={usageCode} lang="vue" collapsible revealId="sensitive-input-usage-code" />
          </div>
        </section>

        <section id="composition" class="docs-section">
          <h2><a class="docs-section-anchor" href="#composition">Composition</a></h2>
          <CompositionTree component="sensitiveInput" />
          <p>
            Sensitive Input owns the visibility and clipboard interaction around one native input.
            Use its optional <code>label</code>, <code>description</code>, and <code>error</code> props for
            a self-contained field. For larger forms, compose the control with Kappa Field or use
            native <code>aria-describedby</code> content around it.
          </p>
          <ul>
            <li>The input stays keyboard reachable while masked. Enter or Space reveals it; Escape masks it.</li>
            <li>Copy uses the unmasked value and emits <code>copy</code> only after a successful write.</li>
            <li>Use <code>v-model</code> for controlled state or <code>defaultValue</code> for an uncontrolled initial value.</li>
            <li>Native input attributes and listeners pass to the input. Classes and styles apply to the Kappa root.</li>
          </ul>
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>
          {
            examples.map((example) => (
              <>
                <h3 id={example.id}><a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a></h3>
                <p>{example.description}</p>
                <div class="docs-component-example">
                  <div class="docs-component-preview"><SensitiveInputDocsDemo client:load variant={example.variant} /></div>
                  <CodeBlock code={example.code} lang="vue" collapsible revealId={`sensitive-input-${example.id}-code`} />
                </div>
              </>
            ))
          }
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <ul>
            <li>Use a visible label whenever the layout permits it, or provide <code>aria-label</code> or <code>aria-labelledby</code>.</li>
            <li>Masked inputs remain keyboard reachable and expose a short instruction through <code>aria-describedby</code>.</li>
            <li>Reveal and copy buttons have changing accessible names. Copy success is announced in a polite live region.</li>
            <li><code>disabled</code> blocks editing, reveal, and copy. <code>readOnly</code> blocks edits but keeps reveal and copy available.</li>
            <li>Connect helper and error text with the built-in props or your own <code>aria-describedby</code> target.</li>
            <li>Focus remains visible in both themes, reduced-motion mode, and forced-color mode.</li>
          </ul>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>
          <div class="docs-api-group">
            <h3 id="root-api"><a class="docs-section-anchor" href="#root-api">SensitiveInput</a></h3>
            <p>Renders a Kappa root, control, native input, and optional action buttons.</p>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{rootProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="parts-api"><a class="docs-section-anchor" href="#parts-api">Parts</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Part</th><th>Element</th><th>Description</th></tr></thead><tbody>{parts.map((part) => <tr><td><code>{part.name}</code></td><td><code>{part.element}</code></td><td>{part.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="events-api"><a class="docs-section-anchor" href="#events-api">Events</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Event</th><th>Payload</th><th>Description</th></tr></thead><tbody>{events.map((event) => <tr><td><code>{event.name}</code></td><td><code>{event.payload}</code></td><td>{event.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="data-attributes"><a class="docs-section-anchor" href="#data-attributes">Data Attributes</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Attribute</th><th>Value</th><th>Description</th></tr></thead><tbody>{dataAttributes.map((attribute) => <tr><td><code>{attribute.name}</code></td><td><code>{attribute.value}</code></td><td>{attribute.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="exports"><a class="docs-section-anchor" href="#exports">Exports</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Export</th><th>Description</th></tr></thead><tbody>{exportsList.map((item) => <tr><td><code>{item.name}</code></td><td>{item.description}</td></tr>)}</tbody></table></div>
          </div>
        </section>

        <DocsPageNavigation currentPath={currentPath} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li><a href="#installation" data-toc-link="installation">Installation</a><ul><li><a href="#barrel" data-toc-link="barrel">Barrel</a></li><li><a href="#granular" data-toc-link="granular">Granular</a></li></ul></li>
            <li><a href="#usage" data-toc-link="usage">Usage</a></li>
            <li><a href="#composition" data-toc-link="composition">Composition</a></li>
            <li><a href="#examples" data-toc-link="examples">Examples</a><ul>{examples.map((example) => <li><a href={`#${example.id}`} data-toc-link={example.id}>{example.title}</a></li>)}</ul></li>
            <li><a href="#accessibility" data-toc-link="accessibility">Accessibility</a></li>
            <li><a href="#api-reference" data-toc-link="api-reference">API Reference</a><ul><li><a href="#root-api" data-toc-link="root-api">SensitiveInput</a></li><li><a href="#parts-api" data-toc-link="parts-api">Parts</a></li><li><a href="#events-api" data-toc-link="events-api">Events</a></li><li><a href="#data-attributes" data-toc-link="data-attributes">Data Attributes</a></li><li><a href="#exports" data-toc-link="exports">Exports</a></li></ul></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
