---
import ArkUiDocsLink from "../../../components/ArkUiDocsLink.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import CompositionTree from "../../../components/CompositionTree.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import RatingDocsDemo from "../../../components/RatingDocsDemo.vue";
import {
  barrelCode,
  compositionCode,
  events,
  examples,
  exportsList,
  granularCode,
  parts,
  rootProps,
  usageCode,
} from "../../../data/rating-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/docs-components.css";

const currentPath = "/docs/components/rating";
const description = "Collects an accessible numeric rating with pointer, keyboard, and form support.";
---

<DocsLayout title="Rating" description={description}>
  <div class="docs-page docs-page--component">
    <header class="docs-page-header"><div class="docs-page-header__inner"><div class="docs-page-header__content">
      <div class="docs-page-header__mobile-actions"><CopyPageControls client:only="vue" align="center" /></div>
      <div class="docs-page-header__title-row"><h1>Rating</h1><ArkUiDocsLink /><div class="docs-page-header__navigation-actions"><div class="docs-page-header__desktop-actions"><CopyPageControls client:only="vue" /></div><DocsPageNavigation currentPath={currentPath} variant="compact" /></div></div>
      <p class="docs-page-header__lede">{description}</p>
    </div></div></header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section"><div class="docs-component-example"><div class="docs-component-preview"><RatingDocsDemo client:load variant="preview" /></div><CodeBlock code={usageCode} lang="vue" collapsible revealId="rating-preview-code" /></div></section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>
          <p>Rating uses Ark UI Rating Group behavior while keeping the public Kappa name short. The default control renders its items and hidden form input automatically.</p>
          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3><CodeBlock code={barrelCode} lang="javascript" />
          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3><CodeBlock code={granularCode} lang="javascript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>Provide a visible label or an accessible name. Use <code>v-model</code> for controlled values and <code>default-value</code> for local state.</p>
          <CodeBlock code={usageCode} lang="vue" />
        </section>

        <section id="composition" class="docs-section">
          <h2><a class="docs-section-anchor" href="#composition">Composition</a></h2>
          <CompositionTree component="rating" />
          <CodeBlock code={compositionCode} lang="vue" />
          <ul><li><code>Control</code> renders the default star items from <code>count</code>.</li><li>Use the scoped Control slot only when the rating needs a different icon.</li><li>The native form input is automatic. Do not add a second hidden input.</li></ul>
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>
          {examples.map((example) => <><h3 id={example.id}><a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a></h3><p>{example.description}</p><div class="docs-component-example"><div class="docs-component-preview"><RatingDocsDemo client:load variant={example.variant} /></div><CodeBlock code={example.code} lang="vue" collapsible revealId={`rating-${example.id}-code`} /></div></>)}
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <ul><li>Arrow keys change the active value. Home and End move to the minimum or maximum value.</li><li>A visible label is preferred. Otherwise, provide <code>aria-label</code> or <code>aria-labelledby</code>.</li><li>Disabled ratings cannot receive input. Read-only ratings expose their value without changing it.</li><li>Custom icons must be decorative. Ark UI supplies each item's accessible name.</li><li>Invalid ratings need nearby error text connected with <code>aria-describedby</code>.</li></ul>
          <p>See the <a href="https://ark-ui.com/docs/components/rating-group">official Ark UI Rating Group documentation</a> for the complete behavior contract.</p>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>
          <div class="docs-api-group"><h3 id="root-api"><a class="docs-section-anchor" href="#root-api">Rating.Root</a></h3><div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{rootProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div></div>
          <div class="docs-api-group"><h3 id="parts-api"><a class="docs-section-anchor" href="#parts-api">Parts</a></h3><div class="docs-api-table"><table><thead><tr><th>Part</th><th>Element</th><th>Description</th></tr></thead><tbody>{parts.map((part) => <tr><td><code>Rating.{part.name}</code></td><td><code>{part.element}</code></td><td>{part.description}</td></tr>)}</tbody></table></div></div>
          <div class="docs-api-group"><h3 id="events-api"><a class="docs-section-anchor" href="#events-api">Events</a></h3><div class="docs-api-table"><table><thead><tr><th>Event</th><th>Payload</th><th>Description</th></tr></thead><tbody>{events.map((event) => <tr><td><code>{event.name}</code></td><td><code>{event.payload}</code></td><td>{event.description}</td></tr>)}</tbody></table></div></div>
          <div class="docs-api-group"><h3 id="exports"><a class="docs-section-anchor" href="#exports">Exports</a></h3><div class="docs-api-table"><table><thead><tr><th>Export</th><th>Description</th></tr></thead><tbody>{exportsList.map((item) => <tr><td><code>{item.name}</code></td><td>{item.description}</td></tr>)}</tbody></table></div></div>
        </section>
        <DocsPageNavigation currentPath={currentPath} />
      </article>
      <aside class="docs-page-toc" aria-label="On this page"><div class="docs-page-toc__inner"><span class="docs-page-toc__title">On this page</span><ul>
        <li><a href="#installation" data-toc-link="installation">Installation</a><ul><li><a href="#barrel" data-toc-link="barrel">Barrel</a></li><li><a href="#granular" data-toc-link="granular">Granular</a></li></ul></li>
        <li><a href="#usage" data-toc-link="usage">Usage</a></li><li><a href="#composition" data-toc-link="composition">Composition</a></li>
        <li><a href="#examples" data-toc-link="examples">Examples</a><ul>{examples.map((example) => <li><a href={`#${example.id}`} data-toc-link={example.id}>{example.title}</a></li>)}</ul></li>
        <li><a href="#accessibility" data-toc-link="accessibility">Accessibility</a></li>
        <li><a href="#api-reference" data-toc-link="api-reference">API Reference</a><ul><li><a href="#root-api" data-toc-link="root-api">Rating.Root</a></li><li><a href="#parts-api" data-toc-link="parts-api">Parts</a></li><li><a href="#events-api" data-toc-link="events-api">Events</a></li><li><a href="#exports" data-toc-link="exports">Exports</a></li></ul></li>
      </ul></div></aside>
    </div>
  </div>
</DocsLayout>
