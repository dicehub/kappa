---
import CodeBlock from "../../../components/CodeBlock.astro";
import CompositionTree from "../../../components/CompositionTree.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import ToolbarDocsDemo from "../../../components/ToolbarDocsDemo.vue";
import {
  toolbarBarrelCode,
  toolbarDataAttributes,
  toolbarExamples,
  toolbarExports,
  toolbarGranularCode,
  toolbarKeyboardRows,
  toolbarPartProps,
  toolbarPreviewCode,
  toolbarProps,
  toolbarUsageCode,
} from "../../../data/toolbar-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/docs-components.css";

const currentPath = "/docs/components/toolbar";
const description =
  "Groups actions, links, and fields into a keyboard-friendly control surface.";

const getDescriptionParts = (value: string) =>
  value.split(/(`[^`]+`)/g).map((part) => ({
    kind: part.startsWith("`") && part.endsWith("`") ? "code" : "text",
    value: part.startsWith("`") && part.endsWith("`") ? part.slice(1, -1) : part,
  }));
---

<DocsLayout title="Toolbar" description={description}>
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-actions">
            <CopyPageControls client:only="vue" align="center" />
          </div>
          <div class="docs-page-header__title-row">
            <h1>Toolbar</h1>
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-actions"><CopyPageControls client:only="vue" /></div>
              <DocsPageNavigation currentPath={currentPath} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">{description}</p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--toolbar">
              <ToolbarDocsDemo client:load variant="preview" />
            </div>
            <CodeBlock code={toolbarPreviewCode} lang="vue" collapsible revealId="toolbar-preview-code" />
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>
          <p>Toolbar is part of the main Kappa package and has no runtime dependency beyond Vue.</p>
          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={toolbarBarrelCode} lang="typescript" />
          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={toolbarGranularCode} lang="typescript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            Use Toolbar when several controls must read as one compact action or filter group. Give
            the root a short accessible name. Use <code>Toolbar.Button</code>, <code>Toolbar.Link</code>,
            <code>Toolbar.Input</code>, and <code>Toolbar.InputGroup</code> for grouped presentation and
            shared keyboard movement.
          </p>
          <CodeBlock code={toolbarUsageCode} lang="vue" />
        </section>

        <section id="composition" class="docs-section">
          <h2><a class="docs-section-anchor" href="#composition">Composition</a></h2>
          <CompositionTree component="toolbar" />
          <p>
            The root renders a native <code>div</code> with <code>role="toolbar"</code>. Supported parts
            inherit the root <code>size</code> and mark one focusable control as the tab stop. A native
            button, link, input, or select may also be composed directly and is discovered for keyboard
            movement.
          </p>
          <ul>
            <li><code>Toolbar.Button</code> uses quiet button styling and defaults to <code>type="button"</code>.</li>
            <li><code>Toolbar.Link</code> preserves link semantics and uses Kappa <code>LinkButton</code> behavior.</li>
            <li>Each focusable control inside <code>Toolbar.InputGroup</code> participates in toolbar focus movement.</li>
            <li>Wrap <code>Toolbar.Button</code> with <code>Select.Trigger as-child</code> to add a Select without changing its popup behavior.</li>
            <li>Wrap <code>Toolbar.Input</code> with <code>Combobox.TriggerInput as-child</code> to add editable Combobox behavior.</li>
            <li><code>Toolbar.Separator</code> is decorative and defaults to the toolbar cross-axis.</li>
            <li>Set <code>orientation="vertical"</code> for a stacked toolbar. Set <code>loopFocus="false"</code> to stop at either edge.</li>
          </ul>
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>
          {
            toolbarExamples.map((example) => (
              <>
                <h3 id={example.id}><a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a></h3>
                <p>
                  {getDescriptionParts(example.description).map((part) =>
                    part.kind === "code" ? <code>{part.value}</code> : part.value,
                  )}
                </p>
                <div class="docs-component-example">
                  <div class="docs-component-preview docs-component-preview--toolbar">
                    <ToolbarDocsDemo client:load variant={example.variant} />
                  </div>
                  <CodeBlock code={example.code} lang="vue" collapsible revealId={`toolbar-${example.id}-code`} />
                </div>
              </>
            ))
          }
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <ul>
            <li>Name the toolbar with a visible label, <code>aria-label</code>, or <code>aria-labelledby</code>.</li>
            <li>Use native buttons for actions and links for navigation. Add an accessible name to every icon-only button and input.</li>
            <li>Disabled controls use native disabled semantics and are skipped by Tab and arrow-key movement.</li>
            <li>Use <code>aria-pressed</code> for formatting toggles; Toolbar does not invent action state.</li>
            <li>Focus indicators remain visible in light, dark, and forced-colors modes.</li>
          </ul>
          <h3 id="keyboard-support"><a class="docs-section-anchor" href="#keyboard-support">Keyboard support</a></h3>
          <div class="docs-api-table">
            <table>
              <thead><tr><th>Key</th><th>Behavior</th></tr></thead>
              <tbody>{toolbarKeyboardRows.map((row) => <tr><td><code>{row.key}</code></td><td>{row.description}</td></tr>)}</tbody>
            </table>
          </div>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>
          <div class="docs-api-group">
            <h3 id="root-api"><a class="docs-section-anchor" href="#root-api">Toolbar.Root</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Prop / Slot</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{toolbarProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="parts-api"><a class="docs-section-anchor" href="#parts-api">Parts</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Part</th><th>Type</th><th>Description</th></tr></thead><tbody>{toolbarPartProps.map((part) => <tr><td><code>{part.name}</code></td><td><code>{part.type}</code></td><td>{part.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="keyboard-api"><a class="docs-section-anchor" href="#keyboard-api">Keyboard</a></h3>
            <p>The root handles navigation for enabled toolbar items and preserves native text editing keys.</p>
            <div class="docs-api-table"><table><thead><tr><th>Key</th><th>Behavior</th></tr></thead><tbody>{toolbarKeyboardRows.map((row) => <tr><td><code>{row.key}</code></td><td>{row.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="data-attributes"><a class="docs-section-anchor" href="#data-attributes">Data attributes</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Attribute</th><th>Value</th><th>Description</th></tr></thead><tbody>{toolbarDataAttributes.map((attribute) => <tr><td><code>{attribute.name}</code></td><td><code>{attribute.value}</code></td><td>{attribute.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="exports"><a class="docs-section-anchor" href="#exports">Exports</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Export</th><th>Description</th></tr></thead><tbody>{toolbarExports.map((item) => <tr><td><code>{item.name}</code></td><td>{item.description}</td></tr>)}</tbody></table></div>
          </div>
        </section>

        <DocsPageNavigation currentPath={currentPath} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li><a href="#installation">Installation</a><ul><li><a href="#barrel">Barrel</a></li><li><a href="#granular">Granular</a></li></ul></li>
            <li><a href="#usage">Usage</a></li>
            <li><a href="#composition">Composition</a></li>
            <li><a href="#examples">Examples</a><ul>{toolbarExamples.map((example) => <li><a href={`#${example.id}`}>{example.title}</a></li>)}</ul></li>
            <li><a href="#accessibility">Accessibility</a><ul><li><a href="#keyboard-support">Keyboard support</a></li></ul></li>
            <li><a href="#api-reference">API Reference</a><ul><li><a href="#root-api">Toolbar.Root</a></li><li><a href="#parts-api">Parts</a></li><li><a href="#keyboard-api">Keyboard</a></li><li><a href="#data-attributes">Data attributes</a></li><li><a href="#exports">Exports</a></li></ul></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
