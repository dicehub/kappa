---
import ArkUiDocsLink from "../../../components/ArkUiDocsLink.astro";
import ClipboardTextDocsDemo from "../../../components/ClipboardTextDocsDemo.vue";
import CodeBlock from "../../../components/CodeBlock.astro";
import CompositionTree from "../../../components/CompositionTree.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import {
  barrelCode,
  compositionCode,
  controlledCode,
  events,
  exportsList,
  granularCode,
  parts,
  previewCode,
  rootProps,
  timeoutCode,
  usageCode,
  valueTextCode,
} from "../../../data/clipboard-text-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/docs-components.css";

const currentPath = "/docs/components/clipboard-text";
const description =
  "Copies identifiers, tokens, and URLs to the clipboard with clear feedback.";
---

<DocsLayout title="Clipboard Text" description={description}>
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-actions">
            <CopyPageControls client:only="vue" align="center" />
          </div>
          <div class="docs-page-header__title-row">
            <h1>Clipboard Text</h1>
            <ArkUiDocsLink />
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-actions"><CopyPageControls client:only="vue" /></div>
              <DocsPageNavigation currentPath={currentPath} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">{description}</p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview"><ClipboardTextDocsDemo client:load variant="preview" /></div>
            <CodeBlock code={previewCode} lang="vue" collapsible revealId="clipboard-text-preview-code" />
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>
          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={barrelCode} lang="javascript" />
          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={granularCode} lang="javascript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            A <code>Control</code> with a read-only <code>Input</code> and a copy
            <code>Trigger</code> covers the common case. The trigger swaps its icon to a check
            while the copied state is active.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><ClipboardTextDocsDemo client:load variant="usage" /></div>
            <CodeBlock code={usageCode} lang="vue" collapsible revealId="clipboard-text-usage-code" />
          </div>
        </section>

        <section id="composition" class="docs-section">
          <h2><a class="docs-section-anchor" href="#composition">Composition</a></h2>
          <CompositionTree component="clipboardText" />
          <p>
            Ark UI owns the copy machine, the clipboard write, the feedback timeout, and status
            announcements. Kappa owns the compound API, the default icon swap, the dense control
            geometry, and semantic tokens.
          </p>
          <ul>
            <li><code>Root</code> owns the value and the copied feedback state.</li>
            <li><code>Trigger</code> copies on click and renders both icons through <code>Indicator</code>.</li>
            <li><code>Indicator</code> renders its default slot, or its <code>copied</code> slot while feedback is active.</li>
            <li><code>ValueText</code> shows the value inline when the bordered control does not fit.</li>
          </ul>
          <p>
            See the <a href="https://ark-ui.com/docs/components/clipboard">Ark UI Clipboard</a>
            guide for the primitive behavior contract.
          </p>
          <div class="docs-component-example">
            <CodeBlock code={compositionCode} lang="vue" collapsible revealId="clipboard-text-composition-code" />
          </div>
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>

          <h3 id="inline-value"><a class="docs-section-anchor" href="#inline-value">Inline Value</a></h3>
          <p><code>ValueText</code> composes the value and trigger without the bordered control.</p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><ClipboardTextDocsDemo client:load variant="value-text" /></div>
            <CodeBlock code={valueTextCode} lang="vue" collapsible revealId="clipboard-text-value-text-code" />
          </div>

          <h3 id="feedback-timeout"><a class="docs-section-anchor" href="#feedback-timeout">Feedback Timeout</a></h3>
          <p><code>timeout</code> controls how long the copied feedback stays visible.</p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><ClipboardTextDocsDemo client:load variant="timeout" /></div>
            <CodeBlock code={timeoutCode} lang="vue" collapsible revealId="clipboard-text-timeout-code" />
          </div>

          <h3 id="controlled"><a class="docs-section-anchor" href="#controlled">Controlled</a></h3>
          <p>
            Use <code>v-model</code> for the value and <code>statusChange</code> to react when a
            copy completes.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><ClipboardTextDocsDemo client:load variant="controlled" /></div>
            <CodeBlock code={controlledCode} lang="vue" collapsible revealId="clipboard-text-controlled-code" />
          </div>
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <ul>
            <li>The trigger is a button; give it a concise accessible name that names the copied value.</li>
            <li>The input stays read-only and selectable, so keyboard users can copy manually.</li>
            <li>The copied state announces through the primitive's status channel and swaps the icon visually.</li>
            <li>Keyboard focus remains visible on the trigger and within the control.</li>
          </ul>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>
          <div class="docs-api-group">
            <h3 id="root-api"><a class="docs-section-anchor" href="#root-api">ClipboardText.Root</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{rootProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="parts-api"><a class="docs-section-anchor" href="#parts-api">Parts</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Part</th><th>Element</th><th>Description</th></tr></thead><tbody>{parts.map((part) => <tr><td><code>ClipboardText.{part.name}</code></td><td><code>{part.element}</code></td><td>{part.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="events-api"><a class="docs-section-anchor" href="#events-api">Events</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Event</th><th>Payload</th><th>Description</th></tr></thead><tbody>{events.map((event) => <tr><td><code>{event.name}</code></td><td><code>{event.payload}</code></td><td>{event.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="exports"><a class="docs-section-anchor" href="#exports">Exports</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Export</th><th>Description</th></tr></thead><tbody>{exportsList.map((item) => <tr><td><code>{item.name}</code></td><td>{item.description}</td></tr>)}</tbody></table></div>
          </div>
        </section>

        <DocsPageNavigation currentPath={currentPath} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li><a href="#installation" data-toc-link="installation">Installation</a><ul><li><a href="#barrel" data-toc-link="barrel">Barrel</a></li><li><a href="#granular" data-toc-link="granular">Granular</a></li></ul></li>
            <li><a href="#usage" data-toc-link="usage">Usage</a></li>
            <li><a href="#composition" data-toc-link="composition">Composition</a></li>
            <li><a href="#examples" data-toc-link="examples">Examples</a><ul><li><a href="#inline-value" data-toc-link="inline-value">Inline Value</a></li><li><a href="#feedback-timeout" data-toc-link="feedback-timeout">Feedback Timeout</a></li><li><a href="#controlled" data-toc-link="controlled">Controlled</a></li></ul></li>
            <li><a href="#accessibility" data-toc-link="accessibility">Accessibility</a></li>
            <li><a href="#api-reference" data-toc-link="api-reference">API Reference</a><ul><li><a href="#root-api" data-toc-link="root-api">ClipboardText.Root</a></li><li><a href="#parts-api" data-toc-link="parts-api">Parts</a></li><li><a href="#events-api" data-toc-link="events-api">Events</a></li><li><a href="#exports" data-toc-link="exports">Exports</a></li></ul></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
