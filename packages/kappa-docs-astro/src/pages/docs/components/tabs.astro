---
import ArkUiDocsLink from "../../../components/ArkUiDocsLink.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import CompositionTree from "../../../components/CompositionTree.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import TabsDocsDemo from "../../../components/TabsDocsDemo.vue";
import {
  barrelCode,
  compositionCode,
  contentProps,
  events,
  examples,
  exportsList,
  granularCode,
  listProps,
  parts,
  previewCode,
  rootProps,
  triggerProps,
  usageCode,
} from "../../../data/tabs-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/docs-components.css";

const currentPath = "/docs/components/tabs";
const description = "Organizes related views behind a precise, keyboard-navigable selection rail.";
---

<DocsLayout title="Tabs" description={description}>
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-actions">
            <CopyPageControls client:only="vue" align="center" />
          </div>
          <div class="docs-page-header__title-row">
            <h1>Tabs</h1>
            <ArkUiDocsLink />
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-actions"><CopyPageControls client:only="vue" /></div>
              <DocsPageNavigation currentPath={currentPath} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">{description}</p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview"><TabsDocsDemo client:only="vue" variant="preview" /></div>
            <CodeBlock code={previewCode} lang="vue" collapsible revealId="tabs-preview-code" />
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>
          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={barrelCode} lang="javascript" />
          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={granularCode} lang="javascript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            Give each <code>Trigger</code> and <code>Content</code> the same stable value attribute. The root owns
            the selected value, while Ark UI supplies the tablist, panel relationships, roving focus, and
            activation behavior. Set visual <code>variant</code> and <code>size</code> on <code>Tabs.List</code>.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><TabsDocsDemo client:only="vue" variant="usage" /></div>
            <CodeBlock code={usageCode} lang="vue" collapsible revealId="tabs-usage-code" />
          </div>
        </section>

        <section id="composition" class="docs-section">
          <h2><a class="docs-section-anchor" href="#composition">Composition</a></h2>
          <CompositionTree component="tabs" />
          <p>
            Use the compound namespace for concise templates or named exports for explicit imports.
            Place <code>Indicator</code> inside <code>List</code> so Ark UI can measure and move it to
            the selected trigger. The <code>Context</code> part exposes the reactive Ark UI API to a
            scoped slot when a custom control needs to call <code>selectNext</code> or inspect focus.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><TabsDocsDemo client:only="vue" variant="composition" /></div>
            <CodeBlock code={compositionCode} lang="vue" collapsible revealId="tabs-composition-code" />
          </div>
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>
          {examples.map((example) => (
            <>
              <h3 id={example.id}><a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a></h3>
              <p>{example.description}</p>
              <div class="docs-component-example">
                <div class="docs-component-preview"><TabsDocsDemo client:only="vue" variant={example.variant} /></div>
                <CodeBlock code={example.code} lang="vue" collapsible revealId={`tabs-${example.id}-code`} />
              </div>
            </>
          ))}
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <ul>
            <li>The list uses <code>role="tablist"</code>; each trigger uses <code>role="tab"</code> and each panel uses <code>role="tabpanel"</code>.</li>
            <li>Tab enters the selected trigger. Arrow keys move between enabled triggers; Home and End move to the first and last trigger.</li>
            <li>Horizontal lists use Left and Right arrows. Vertical lists use Up and Down arrows. Direction follows the root locale and <code>dir</code>.</li>
            <li>Automatic activation selects a tab on focus. Manual activation moves focus first and waits for Enter or Space to select.</li>
            <li>Disabled triggers are unavailable and skipped by directional keyboard navigation.</li>
            <li>Keep trigger labels concise and give the root an accessible name when the visible context is not enough.</li>
            <li>Keep focus visible. Indicator and trigger transitions honor <code>prefers-reduced-motion</code>.</li>
          </ul>
          <p>Kappa preserves Ark UI behavior.</p>
          <p>
            <a href="https://ark-ui.com/docs/components/tabs">Official Ark UI Tabs documentation</a>
          </p>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>
          <div class="docs-api-group">
            <h3 id="root-api"><a class="docs-section-anchor" href="#root-api">Tabs.Root</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{rootProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="list-api"><a class="docs-section-anchor" href="#list-api">Tabs.List</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{listProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="trigger-api"><a class="docs-section-anchor" href="#trigger-api">Tabs.Trigger</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{triggerProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="content-api"><a class="docs-section-anchor" href="#content-api">Tabs.Content</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{contentProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="parts-api"><a class="docs-section-anchor" href="#parts-api">Parts</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Part</th><th>Element</th><th>Description</th></tr></thead><tbody>{parts.map((part) => <tr><td><code>Tabs.{part.name}</code></td><td><code>{part.element}</code></td><td>{part.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="events-api"><a class="docs-section-anchor" href="#events-api">Events</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Event</th><th>Payload</th><th>Description</th></tr></thead><tbody>{events.map((event) => <tr><td><code>{event.name}</code></td><td><code>{event.payload}</code></td><td>{event.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="exports"><a class="docs-section-anchor" href="#exports">Exports</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Export</th><th>Description</th></tr></thead><tbody>{exportsList.map((item) => <tr><td><code>{item.name}</code></td><td>{item.description}</td></tr>)}</tbody></table></div>
          </div>
        </section>

        <DocsPageNavigation currentPath={currentPath} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li><a href="#installation" data-toc-link="installation">Installation</a><ul><li><a href="#barrel" data-toc-link="barrel">Barrel</a></li><li><a href="#granular" data-toc-link="granular">Granular</a></li></ul></li>
            <li><a href="#usage" data-toc-link="usage">Usage</a></li>
            <li><a href="#composition" data-toc-link="composition">Composition</a></li>
            <li><a href="#examples" data-toc-link="examples">Examples</a><ul>{examples.map((example) => <li><a href={`#${example.id}`} data-toc-link={example.id}>{example.title}</a></li>)}</ul></li>
            <li><a href="#accessibility" data-toc-link="accessibility">Accessibility</a></li>
            <li><a href="#api-reference" data-toc-link="api-reference">API Reference</a><ul><li><a href="#root-api" data-toc-link="root-api">Tabs.Root</a></li><li><a href="#list-api" data-toc-link="list-api">Tabs.List</a></li><li><a href="#trigger-api" data-toc-link="trigger-api">Tabs.Trigger</a></li><li><a href="#content-api" data-toc-link="content-api">Tabs.Content</a></li><li><a href="#parts-api" data-toc-link="parts-api">Parts</a></li><li><a href="#events-api" data-toc-link="events-api">Events</a></li><li><a href="#exports" data-toc-link="exports">Exports</a></li></ul></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
