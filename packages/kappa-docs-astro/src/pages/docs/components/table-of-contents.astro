---
import ArkUiDocsLink from "../../../components/ArkUiDocsLink.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import CompositionTree from "../../../components/CompositionTree.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import TableOfContentsDocsDemo from "../../../components/TableOfContentsDocsDemo.vue";
import {
  tableOfContentsBarrelCode,
  tableOfContentsDataAttributes,
  tableOfContentsEvents,
  tableOfContentsExamples,
  tableOfContentsExports,
  tableOfContentsGranularCode,
  tableOfContentsKeyboardRows,
  tableOfContentsParts,
  tableOfContentsPreviewCode,
  tableOfContentsRootProps,
  tableOfContentsUsageCode,
} from "../../../data/table-of-contents-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/docs-components.css";

const currentPath = "/docs/components/table-of-contents";
const description =
  "Ark-backed section navigation with nested depth, active tracking, and a moving indicator.";

const getDescriptionParts = (value: string) =>
  value.split(/(`[^`]+`)/g).map((part) => ({
    kind: part.startsWith("`") && part.endsWith("`") ? "code" : "text",
    value: part.startsWith("`") && part.endsWith("`") ? part.slice(1, -1) : part,
  }));
---

<DocsLayout title="Table of Contents" description={description}>
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-actions">
            <CopyPageControls client:only="vue" align="center" />
          </div>
          <div class="docs-page-header__title-row">
            <h1>Table of Contents</h1>
            <ArkUiDocsLink />
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-actions"><CopyPageControls client:only="vue" /></div>
              <DocsPageNavigation currentPath={currentPath} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">{description}</p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview docs-component-preview--table-of-contents">
              <TableOfContentsDocsDemo client:only="vue" variant="preview" />
            </div>
            <CodeBlock code={tableOfContentsPreviewCode} lang="vue" collapsible revealId="table-of-contents-preview-code" />
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>
          <p>Table of Contents is part of the main Kappa package. Ark UI and Zag own the state machine and visibility tracking.</p>
          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={tableOfContentsBarrelCode} lang="typescript" />
          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={tableOfContentsGranularCode} lang="typescript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            Build an <code>items</code> array with heading <code>value</code> ids and numeric
            <code>depth</code>. Pass the same array to <code>TableOfContents.Root</code>, then compose
            the Ark-backed parts inside <code>Nav</code>.
          </p>
          <p>
            Give each <code>TableOfContents.Root</code> and <code>TableOfContents.Nav</code> a
            distinct <code>id</code>. For a local scroll panel, use <code>scrollEl</code>
            and scroll that element to keep the page position unchanged.
          </p>
          <CodeBlock code={tableOfContentsUsageCode} lang="vue" />
        </section>

        <section id="composition" class="docs-section">
          <h2><a class="docs-section-anchor" href="#composition">Composition</a></h2>
          <CompositionTree component="tableOfContents" />
          <p>
            <code>Root</code> creates the Ark TOC machine and provides context. <code>Content</code> is
            an article wrapper, <code>Nav</code> is the semantic navigation region, and <code>Title</code>
            labels it. <code>Item</code> binds one item object; its <code>Link</code> receives the active
            state and same-page scroll behavior from Ark UI. <code>Indicator</code> tracks the active range.
          </p>
          <p>
            Use <code>Context</code> for a renderless API readout. Create a machine with
            <code>useToc</code> and pass it to <code>RootProvider</code> when state must be created outside
            the template. Kappa adds rails, depth indentation, focus styles, and semantic light/dark tokens.
          </p>
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>
          <p>
            These previews render <code>Link</code> as a button with <code>asChild</code>, so trying an
            example does not move this documentation page. Use same-page anchors in production.
          </p>
          {
            tableOfContentsExamples.map((example) => (
              <>
                <h3 id={example.id}><a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a></h3>
                <p>
                  {getDescriptionParts(example.description).map((part) =>
                    part.kind === "code" ? <code>{part.value}</code> : part.value,
                  )}
                </p>
                <div class="docs-component-example">
                  <div class="docs-component-preview docs-component-preview--table-of-contents">
                    <TableOfContentsDocsDemo client:only="vue" variant={example.variant} />
                  </div>
                  <CodeBlock code={example.code} lang="vue" collapsible revealId={`table-of-contents-${example.id}-code`} />
                </div>
              </>
            ))
          }
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <ul>
            <li>Give <code>Nav</code> a visible <code>Title</code>; Ark uses it to provide the navigation name.</li>
            <li>Use real heading ids in <code>items</code>; the observed heading and item <code>value</code> must match.</li>
            <li>Keep links as links. Ark preserves same-page navigation, focus, and scroll behavior.</li>
            <li>Active state is exposed with <code>data-active</code> and <code>aria-current="location"</code>.</li>
            <li>Focus-visible styles, forced-colors styles, and reduced-motion behavior are included.</li>
          </ul>
          <h3 id="keyboard-support"><a class="docs-section-anchor" href="#keyboard-support">Keyboard support</a></h3>
          <div class="docs-api-table"><table><thead><tr><th>Key</th><th>Behavior</th></tr></thead><tbody>{tableOfContentsKeyboardRows.map((row) => <tr><td><code>{row.key}</code></td><td>{row.description}</td></tr>)}</tbody></table></div>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>
          <div class="docs-api-group">
            <h3 id="root-api"><a class="docs-section-anchor" href="#root-api">TableOfContents.Root</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{tableOfContentsRootProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="parts-api"><a class="docs-section-anchor" href="#parts-api">Parts</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Part</th><th>Element</th><th>Description</th></tr></thead><tbody>{tableOfContentsParts.map((part) => <tr><td><code>TableOfContents.{part.name}</code></td><td><code>{part.element}</code></td><td>{part.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="events-api"><a class="docs-section-anchor" href="#events-api">Events</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Event</th><th>Payload</th><th>Description</th></tr></thead><tbody>{tableOfContentsEvents.map((event) => <tr><td><code>{event.name}</code></td><td><code>{event.payload}</code></td><td>{event.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="data-attributes"><a class="docs-section-anchor" href="#data-attributes">Data attributes</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Attribute</th><th>Value</th><th>Description</th></tr></thead><tbody>{tableOfContentsDataAttributes.map((attribute) => <tr><td><code>{attribute.name}</code></td><td><code>{attribute.value}</code></td><td>{attribute.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="exports"><a class="docs-section-anchor" href="#exports">Exports</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Export</th><th>Description</th></tr></thead><tbody>{tableOfContentsExports.map((item) => <tr><td><code>{item.name}</code></td><td>{item.description}</td></tr>)}</tbody></table></div>
          </div>
        </section>

        <DocsPageNavigation currentPath={currentPath} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li><a href="#installation">Installation</a><ul><li><a href="#barrel">Barrel</a></li><li><a href="#granular">Granular</a></li></ul></li>
            <li><a href="#usage">Usage</a></li>
            <li><a href="#composition">Composition</a></li>
            <li><a href="#examples">Examples</a><ul>{tableOfContentsExamples.map((example) => <li><a href={`#${example.id}`}>{example.title}</a></li>)}</ul></li>
            <li><a href="#accessibility">Accessibility</a><ul><li><a href="#keyboard-support">Keyboard support</a></li></ul></li>
            <li><a href="#api-reference">API Reference</a><ul><li><a href="#root-api">TableOfContents.Root</a></li><li><a href="#parts-api">Parts</a></li><li><a href="#events-api">Events</a></li><li><a href="#data-attributes">Data attributes</a></li><li><a href="#exports">Exports</a></li></ul></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
