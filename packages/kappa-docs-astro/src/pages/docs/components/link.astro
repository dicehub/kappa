---
import ArkUiDocsLink from "../../../components/ArkUiDocsLink.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import CompositionTree from "../../../components/CompositionTree.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import LinkDocsDemo from "../../../components/LinkDocsDemo.vue";
import {
  barrelCode,
  currentCode,
  currentPageCode,
  dataAttributes,
  exportsList,
  externalCode,
  granularCode,
  inlineParagraphCode,
  linkProps,
  previewCode,
  routerCode,
  rtlCode,
  slots,
  usageCode,
  variantsCode,
} from "../../../data/link-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/docs-components.css";

const currentPath = "/docs/components/link";
const description =
  "A semantic anchor for inline navigation, external destinations, and framework-router composition.";

const examples = [
  {
    id: "variants",
    title: "Variants",
    description: "Use inline in prose, current in colored contexts, and plain where layout already identifies navigation.",
    variant: "variants",
    code: variantsCode,
  },
  {
    id: "inline-in-paragraph",
    title: "Inline in Paragraph",
    description: "An inline link follows the surrounding type scale, line height, and sentence flow.",
    variant: "inline-paragraph",
    code: inlineParagraphCode,
  },
  {
    id: "external-link",
    title: "External Link",
    description: "The external prop supplies safe new-context defaults. LinkExternalIcon is Kappa's built-in decorative indicator; Link.ExternalIcon is the equivalent compound form.",
    variant: "external",
    code: externalCode,
  },
  {
    id: "current-color",
    title: "Current Color",
    description: "The current variant inherits its surrounding semantic color without losing the underline cue.",
    variant: "current",
    code: currentCode,
  },
  {
    id: "router-link",
    title: "Router Link",
    description: "Use asChild with one router component. The child owns its destination and Kappa merges styling and attributes onto it.",
    variant: "router",
    code: routerCode,
  },
  {
    id: "current-page",
    title: "Current Page",
    description: "Keep native aria-current on the active destination so the state is available beyond color.",
    variant: "current-page",
    code: currentPageCode,
  },
  {
    id: "right-to-left",
    title: "Right to Left",
    description: "Logical spacing keeps text and inline content ordered by the inherited writing direction.",
    variant: "rtl",
    code: rtlCode,
  },
] as const;
---

<DocsLayout title="Link" description={description}>
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-actions">
            <CopyPageControls client:only="vue" align="center" />
          </div>
          <div class="docs-page-header__title-row">
            <h1>Link</h1>
            <ArkUiDocsLink href="https://ark-ui.com/docs/guides/composition" />
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-actions">
                <CopyPageControls client:only="vue" />
              </div>
              <DocsPageNavigation currentPath={currentPath} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">{description}</p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview">
              <LinkDocsDemo client:load variant="preview" />
            </div>
            <CodeBlock code={previewCode} lang="vue" collapsible revealId="link-preview-code" />
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>
          <p>
            Link is part of the main Kappa package. Native anchor behavior owns navigation and the
            Ark UI factory supplies attribute merging for framework composition.
          </p>
          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={barrelCode} lang="javascript" />
          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={granularCode} lang="javascript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            Use Link when activation changes location. Use Button for an action and LinkButton when
            navigation needs button geometry. Link text must describe the destination.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview">
              <LinkDocsDemo client:load variant="basic" />
            </div>
            <CodeBlock code={usageCode} lang="vue" collapsible revealId="link-usage-code" />
          </div>
        </section>

        <section id="composition" class="docs-section">
          <h2><a class="docs-section-anchor" href="#composition">Composition</a></h2>
          <CompositionTree component="link" />
          <p>
            Anchors navigate, while buttons perform actions. The
            <a href="https://ark-ui.com/docs/guides/composition">Ark UI composition guide</a>
            defines the single-child <code>asChild</code> contract.
          </p>
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>
          {
            examples.map((example) => (
              <>
                <h3 id={example.id}>
                  <a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a>
                </h3>
                <p>{example.description}</p>
                <div class="docs-component-example">
                  <div class="docs-component-preview">
                    <LinkDocsDemo client:load variant={example.variant} />
                  </div>
                  <CodeBlock
                    code={example.code}
                    lang="vue"
                    collapsible
                    revealId={`link-${example.id}-code`}
                  />
                </div>
              </>
            ))
          }
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <ul>
            <li>Use Link only for navigation. Use Button for commands, toggles, and form submission.</li>
            <li>Write destination-specific text. Do not use vague text such as “click here.”</li>
            <li>Do not simulate a disabled anchor. Remove it, omit its destination, or use the correct control.</li>
            <li>Use <code>aria-current="page"</code> for the current destination in a navigation group.</li>
            <li>Tell users when a link opens a new context. The external icon is decorative, not an accessible name.</li>
            <li>Keep one element inside <code>asChild</code>, and ensure that it renders a semantic link.</li>
          </ul>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>
          <div class="docs-api-group">
            <h3 id="link-api"><a class="docs-section-anchor" href="#link-api">Link</a></h3>
            <p>Renders one anchor by default and forwards native attributes and listeners.</p>
            <div class="docs-api-table">
              <table>
                <thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                <tbody>
                  {linkProps.map((prop) => (
                    <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
          <div class="docs-api-group">
            <h3 id="slots"><a class="docs-section-anchor" href="#slots">Slots</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Slot</th><th>Description</th></tr></thead><tbody>{slots.map((slot) => <tr><td><code>{slot.name}</code></td><td>{slot.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="data-attributes"><a class="docs-section-anchor" href="#data-attributes">Data Attributes</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Attribute</th><th>Value</th><th>Description</th></tr></thead><tbody>{dataAttributes.map((attribute) => <tr><td><code>{attribute.name}</code></td><td><code>{attribute.value}</code></td><td>{attribute.description}</td></tr>)}</tbody></table></div>
          </div>
          <div class="docs-api-group">
            <h3 id="exports"><a class="docs-section-anchor" href="#exports">Exports</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Export</th><th>Description</th></tr></thead><tbody>{exportsList.map((item) => <tr><td><code>{item.name}</code></td><td>{item.description}</td></tr>)}</tbody></table></div>
          </div>
        </section>

        <DocsPageNavigation currentPath={currentPath} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li><a href="#installation" data-toc-link="installation">Installation</a><ul><li><a href="#barrel" data-toc-link="barrel">Barrel</a></li><li><a href="#granular" data-toc-link="granular">Granular</a></li></ul></li>
            <li><a href="#usage" data-toc-link="usage">Usage</a></li>
            <li><a href="#composition" data-toc-link="composition">Composition</a></li>
            <li><a href="#examples" data-toc-link="examples">Examples</a><ul>{examples.map((example) => <li><a href={`#${example.id}`} data-toc-link={example.id}>{example.title}</a></li>)}</ul></li>
            <li><a href="#accessibility" data-toc-link="accessibility">Accessibility</a></li>
            <li><a href="#api-reference" data-toc-link="api-reference">API Reference</a><ul><li><a href="#link-api" data-toc-link="link-api">Link</a></li><li><a href="#slots" data-toc-link="slots">Slots</a></li><li><a href="#data-attributes" data-toc-link="data-attributes">Data Attributes</a></li><li><a href="#exports" data-toc-link="exports">Exports</a></li></ul></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
