---
import EmptyDocsDemo from "../../../components/EmptyDocsDemo.vue";
import CodeBlock from "../../../components/CodeBlock.astro";
import CompositionTree from "../../../components/CompositionTree.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import {
  actionsCode,
  avatarCode,
  avatarGroupCode,
  barrelCode,
  compositionCode,
  exportsList,
  granularCode,
  mediaCode,
  mediaProps,
  outlinedCode,
  parts,
  previewCode,
  rootProps,
  rtlCode,
  sizesCode,
  statusCode,
  titleProps,
  usageCode,
} from "../../../data/empty-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/docs-components.css";

const currentPath = "/docs/components/empty";
const description =
  "Explains absent content and guides the user toward a useful next action.";
---

<DocsLayout title="Empty" description={description}>
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-actions">
            <CopyPageControls client:only="vue" align="center" />
          </div>
          <div class="docs-page-header__title-row">
            <h1>Empty</h1>
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-actions"><CopyPageControls client:only="vue" /></div>
              <DocsPageNavigation currentPath={currentPath} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">{description}</p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview">
              <EmptyDocsDemo client:load variant="preview" />
            </div>
            <CodeBlock code={previewCode} lang="vue" collapsible revealId="empty-preview-code" />
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>
          <p>
            Empty is part of the main Kappa package. It has no state machine because the component is
            presentational. The application decides when the state appears and whether changes need an announcement.
          </p>
          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={barrelCode} lang="javascript" />
          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={granularCode} lang="javascript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            State what is absent, explain the reason when it helps, and provide one clear next action.
            Empty has no border or background by default, so it can sit inside tables, panels, and pages.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><EmptyDocsDemo client:load variant="basic" /></div>
            <CodeBlock code={usageCode} lang="vue" collapsible revealId="empty-usage-code" />
          </div>
        </section>

        <section id="composition" class="docs-section">
          <h2><a class="docs-section-anchor" href="#composition">Composition</a></h2>
          <CompositionTree component="empty" />
          <p>
            Use the compound API for readable templates. Named exports provide the same parts when a
            template or build rule prefers unaugmented components. Empty uses Kappa's size and visual rules.
          </p>
          <CodeBlock code={compositionCode} lang="vue" />
          <p>
            No Ark UI Empty primitive is available, so Kappa owns only this static structure and style.
          </p>
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>

          <h3 id="sizes"><a class="docs-section-anchor" href="#sizes">Sizes</a></h3>
          <p>Use small inside dense panels, base for most surfaces, and large for primary page states.</p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><EmptyDocsDemo client:load variant="sizes" /></div>
            <CodeBlock code={sizesCode} lang="vue" collapsible revealId="empty-sizes-code" />
          </div>

          <h3 id="custom-media"><a class="docs-section-anchor" href="#custom-media">Custom Media</a></h3>
          <p>
            The default media variant leaves custom visuals unchanged. Use the icon variant only for
            compact decorative icons.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><EmptyDocsDemo client:load variant="media" /></div>
            <CodeBlock code={mediaCode} lang="vue" collapsible revealId="empty-media-code" />
          </div>

          <h3 id="avatar"><a class="docs-section-anchor" href="#avatar">Avatar</a></h3>
          <p>
            Place one Avatar in the default media container for a person-specific empty state. When
            the visible title already names the person, use an empty image alternative to avoid repetition.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><EmptyDocsDemo client:load variant="avatar" /></div>
            <CodeBlock code={avatarCode} lang="vue" collapsible revealId="empty-avatar-code" />
          </div>

          <h3 id="avatar-group"><a class="docs-section-anchor" href="#avatar-group">Avatar Group</a></h3>
          <p>
            An Avatar Group can suggest collaboration or team setup. Hide an illustrative group from
            assistive technology when the title and description contain the useful message.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><EmptyDocsDemo client:load variant="avatar-group" /></div>
            <CodeBlock code={avatarGroupCode} lang="vue" collapsible revealId="empty-avatar-group-code" />
          </div>

          <h3 id="with-actions"><a class="docs-section-anchor" href="#with-actions">With Actions</a></h3>
          <p>Place the primary recovery action first. Keep secondary guidance quiet.</p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><EmptyDocsDemo client:load variant="actions" /></div>
            <CodeBlock code={actionsCode} lang="vue" collapsible revealId="empty-actions-code" />
          </div>

          <h3 id="outlined-container"><a class="docs-section-anchor" href="#outlined-container">Outlined Container</a></h3>
          <p>
            Add a consumer class when the empty state must define a drop zone or bounded region. Do not
            add a container only to decorate an already clear layout.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><EmptyDocsDemo client:load variant="outlined" /></div>
            <CodeBlock code={outlinedCode} lang="vue" collapsible revealId="empty-outlined-code" />
          </div>

          <h3 id="dynamic-status"><a class="docs-section-anchor" href="#dynamic-status">Dynamic Status</a></h3>
          <p>
            Add status semantics only when an empty result appears after an asynchronous change and the
            update is useful without focus movement.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><EmptyDocsDemo client:load variant="status" /></div>
            <CodeBlock code={statusCode} lang="vue" collapsible revealId="empty-status-code" />
          </div>

          <h3 id="right-to-left"><a class="docs-section-anchor" href="#right-to-left">Right-to-left</a></h3>
          <p>Logical sizing and alignment follow the inherited text direction.</p>
          <div class="docs-component-example">
            <div class="docs-component-preview"><EmptyDocsDemo client:load variant="rtl" /></div>
            <CodeBlock code={rtlCode} lang="vue" collapsible revealId="empty-rtl-code" />
          </div>
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <ul>
            <li>Empty is presentational by default. It does not add <code>role="status"</code> or <code>aria-live</code>.</li>
            <li>Use a title element that fits the document hierarchy. The default is <code>h3</code>; change it with <code>as</code>.</li>
            <li>Mark a decorative media icon with <code>aria-hidden="true"</code>. Give informative images useful alternative text.</li>
            <li>Do not announce empty content that was already present at page load. Live regions are for meaningful dynamic changes.</li>
            <li>Use clear action labels. Do not rely on an icon or color to explain the recovery path.</li>
            <li>Keep keyboard focus on the control that caused a filtered empty result unless the workflow requires a deliberate move.</li>
          </ul>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>

          <div class="docs-api-group">
            <h3 id="root-api"><a class="docs-section-anchor" href="#root-api">Empty.Root</a></h3>
            <p>Renders a div and forwards native attributes and listeners.</p>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{rootProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>

          <div class="docs-api-group">
            <h3 id="media-api"><a class="docs-section-anchor" href="#media-api">Empty.Media</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{mediaProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>

          <div class="docs-api-group">
            <h3 id="title-api"><a class="docs-section-anchor" href="#title-api">Empty.Title</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{titleProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>

          <div class="docs-api-group">
            <h3 id="parts-api"><a class="docs-section-anchor" href="#parts-api">Parts</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Part</th><th>Element</th><th>Description</th></tr></thead><tbody>{parts.map((part) => <tr><td><code>{part.name}</code></td><td><code>{part.element}</code></td><td>{part.description}</td></tr>)}</tbody></table></div>
          </div>

          <div class="docs-api-group">
            <h3 id="exports"><a class="docs-section-anchor" href="#exports">Exports</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Export</th><th>Description</th></tr></thead><tbody>{exportsList.map((item) => <tr><td><code>{item.name}</code></td><td>{item.description}</td></tr>)}</tbody></table></div>
          </div>
        </section>

        <DocsPageNavigation currentPath={currentPath} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li><a href="#installation" data-toc-link="installation">Installation</a><ul><li><a href="#barrel" data-toc-link="barrel">Barrel</a></li><li><a href="#granular" data-toc-link="granular">Granular</a></li></ul></li>
            <li><a href="#usage" data-toc-link="usage">Usage</a></li>
            <li><a href="#composition" data-toc-link="composition">Composition</a></li>
            <li><a href="#examples" data-toc-link="examples">Examples</a><ul><li><a href="#sizes" data-toc-link="sizes">Sizes</a></li><li><a href="#custom-media" data-toc-link="custom-media">Custom Media</a></li><li><a href="#avatar" data-toc-link="avatar">Avatar</a></li><li><a href="#avatar-group" data-toc-link="avatar-group">Avatar Group</a></li><li><a href="#with-actions" data-toc-link="with-actions">With Actions</a></li><li><a href="#outlined-container" data-toc-link="outlined-container">Outlined Container</a></li><li><a href="#dynamic-status" data-toc-link="dynamic-status">Dynamic Status</a></li><li><a href="#right-to-left" data-toc-link="right-to-left">Right-to-left</a></li></ul></li>
            <li><a href="#accessibility" data-toc-link="accessibility">Accessibility</a></li>
            <li><a href="#api-reference" data-toc-link="api-reference">API Reference</a><ul><li><a href="#root-api" data-toc-link="root-api">Empty.Root</a></li><li><a href="#media-api" data-toc-link="media-api">Empty.Media</a></li><li><a href="#title-api" data-toc-link="title-api">Empty.Title</a></li><li><a href="#parts-api" data-toc-link="parts-api">Parts</a></li><li><a href="#exports" data-toc-link="exports">Exports</a></li></ul></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
