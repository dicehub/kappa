---
import CodeBlock from "../../../components/CodeBlock.astro";
import CompositionTree from "../../../components/CompositionTree.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import FlowDocsDemo from "../../../components/FlowDocsDemo.vue";
import {
  anchorProps,
  barrelCode,
  compositionCode,
  examples,
  exportsList,
  granularCode,
  nodeProps,
  parallelProps,
  parts,
  previewCode,
  rootProps,
  usageCode,
} from "../../../data/flow-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/docs-components.css";

const currentPath = "/docs/components/flow";
const description =
  "Visualizes sequential and parallel process paths with measured nodes, connectors, and an optional pannable canvas.";
---

<DocsLayout title="Flow" description={description}>
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-actions">
            <CopyPageControls client:only="vue" align="center" />
          </div>
          <div class="docs-page-header__title-row">
            <h1>Flow</h1>
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-actions">
                <CopyPageControls client:only="vue" />
              </div>
              <DocsPageNavigation currentPath={currentPath} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">{description}</p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview">
              <FlowDocsDemo client:load variant="preview" />
            </div>
            <CodeBlock code={previewCode} lang="vue" collapsible revealId="flow-preview-code" />
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>
          <p>
            Flow is part of the main Kappa package. It uses Vue and browser measurement APIs. It
            adds no component-specific dependency.
          </p>
          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={barrelCode} lang="javascript" />
          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={granularCode} lang="javascript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            Put nodes in source order. Flow measures each node after mount and draws one directed
            connector between adjacent steps. Give the root an accessible label when the diagram
            has meaning beyond the surrounding text.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview">
              <FlowDocsDemo client:load variant="usage" />
            </div>
            <CodeBlock code={usageCode} lang="vue" collapsible revealId="flow-usage-code" />
          </div>
        </section>

        <section id="composition" class="docs-section">
          <h2><a class="docs-section-anchor" href="#composition">Composition</a></h2>
          <CompositionTree component="flow" />
          <p>
            Ark UI does not supply an equivalent primitive. Kappa therefore owns the
            layout, measurement, connector, and canvas behavior.
          </p>
          <p>
            Use <code>Flow.Parallel</code> for independent branches. Put
            <code>Flow.List</code> inside it when one branch contains several sequential nodes. Add
            an ordinary node between adjacent parallel groups when the paths must converge before
            they split again.
          </p>
          <CodeBlock code={compositionCode} lang="vue" />
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>
          {
            examples.map((example) => (
              <>
                <h3 id={example.id}>
                  <a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a>
                </h3>
                <p>{example.description}</p>
                <div class="docs-component-example">
                  <div class="docs-component-preview">
                    <FlowDocsDemo client:load variant={example.variant} />
                  </div>
                  <CodeBlock
                    code={example.code}
                    lang="vue"
                    collapsible
                    revealId={`flow-${example.id}-code`}
                  />
                </div>
              </>
            ))
          }
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <ul>
            <li>The root and compound parts preserve native <code>ul</code> and <code>li</code> reading order.</li>
            <li>The connector SVG is decorative and hidden from assistive technology.</li>
            <li>Keep source order meaningful. Visual branches do not change the screen-reader order.</li>
            <li>Use <code>aria-label</code> or <code>aria-labelledby</code> when surrounding text does not name the diagram.</li>
            <li>An overflowing canvas receives keyboard focus. Arrow keys pan by 40 px; Shift plus an arrow pans by 96 px. Home and End move to opposite bounds.</li>
            <li>Disabled nodes expose <code>aria-disabled="true"</code>. Do not use color alone to explain why a path is inactive.</li>
            <li>Forced-colors mode keeps nodes and connectors visible. Reduced-motion mode removes the scrollbar fade.</li>
          </ul>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>

          <div class="docs-api-group">
            <h3 id="root-api"><a class="docs-section-anchor" href="#root-api">Flow.Root</a></h3>
            <p>Measures the diagram, positions nodes, draws connectors, and controls canvas overflow.</p>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{rootProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>

          <div class="docs-api-group">
            <h3 id="node-api"><a class="docs-section-anchor" href="#node-api">Flow.Node</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{nodeProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>

          <div class="docs-api-group">
            <h3 id="parallel-api"><a class="docs-section-anchor" href="#parallel-api">Flow.Parallel</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{parallelProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>

          <div class="docs-api-group">
            <h3 id="anchor-api"><a class="docs-section-anchor" href="#anchor-api">Flow.Anchor</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{anchorProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>

          <div class="docs-api-group">
            <h3 id="parts-api"><a class="docs-section-anchor" href="#parts-api">Parts</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Part</th><th>Element</th><th>Description</th></tr></thead><tbody>{parts.map((part) => <tr><td><code>{part.name}</code></td><td><code>{part.element}</code></td><td>{part.description}</td></tr>)}</tbody></table></div>
          </div>

          <div class="docs-api-group">
            <h3 id="exports"><a class="docs-section-anchor" href="#exports">Exports</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Export</th><th>Description</th></tr></thead><tbody>{exportsList.map((item) => <tr><td><code>{item.name}</code></td><td>{item.description}</td></tr>)}</tbody></table></div>
          </div>
        </section>

        <DocsPageNavigation currentPath={currentPath} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li><a href="#installation" data-toc-link="installation">Installation</a><ul><li><a href="#barrel" data-toc-link="barrel">Barrel</a></li><li><a href="#granular" data-toc-link="granular">Granular</a></li></ul></li>
            <li><a href="#usage" data-toc-link="usage">Usage</a></li>
            <li><a href="#composition" data-toc-link="composition">Composition</a></li>
            <li><a href="#examples" data-toc-link="examples">Examples</a><ul>{examples.map((example) => <li><a href={`#${example.id}`} data-toc-link={example.id}>{example.title}</a></li>)}</ul></li>
            <li><a href="#accessibility" data-toc-link="accessibility">Accessibility</a></li>
            <li><a href="#api-reference" data-toc-link="api-reference">API Reference</a><ul><li><a href="#root-api" data-toc-link="root-api">Flow.Root</a></li><li><a href="#node-api" data-toc-link="node-api">Flow.Node</a></li><li><a href="#parallel-api" data-toc-link="parallel-api">Flow.Parallel</a></li><li><a href="#anchor-api" data-toc-link="anchor-api">Flow.Anchor</a></li><li><a href="#parts-api" data-toc-link="parts-api">Parts</a></li><li><a href="#exports" data-toc-link="exports">Exports</a></li></ul></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
