---
import ArkUiDocsLink from "../../../components/ArkUiDocsLink.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import CompositionTree from "../../../components/CompositionTree.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import NativeSelectDocsDemo from "../../../components/NativeSelectDocsDemo.vue";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import {
  barrelCode,
  basicCode,
  dataAttributes,
  events,
  exportsList,
  granularCode,
  groupsCode,
  multipleCode,
  nativeSelectProps,
  previewCode,
  rtlCode,
  sizesCode,
  statesCode,
} from "../../../data/native-select-docs";
import "../../../styles/docs-components.css";

const currentPath = "/docs/components/native-select";
const description =
  "A styled native select for simple choices, platform menus, and direct form submission.";
---

<DocsLayout title="Native Select" description={description}>
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-actions">
            <CopyPageControls client:only="vue" align="center" />
          </div>
          <div class="docs-page-header__title-row">
            <h1>Native Select</h1>
            <ArkUiDocsLink />
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-actions">
                <CopyPageControls client:only="vue" />
              </div>
              <DocsPageNavigation currentPath={currentPath} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">{description}</p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview">
              <NativeSelectDocsDemo client:load variant="preview" />
            </div>
            <CodeBlock
              code={previewCode}
              lang="vue"
              collapsible
              revealId="native-select-preview-code"
            />
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>
          <p>
            Native Select is part of the main Kappa package. It uses the browser select element and
            adds no state-machine dependency.
          </p>
          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={barrelCode} lang="javascript" />
          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={granularCode} lang="javascript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            Add an accessible name, then use <code>v-model</code> or a native initial
            <code>value</code>. Native form attributes and event listeners pass to the select.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview">
              <NativeSelectDocsDemo client:load variant="basic" />
            </div>
            <CodeBlock
              code={basicCode}
              lang="vue"
              collapsible
              revealId="native-select-basic-code"
            />
          </div>
        </section>

        <section id="composition" class="docs-section">
          <h2><a class="docs-section-anchor" href="#composition">Composition</a></h2>
          <CompositionTree component="nativeSelect" />
          <p>
            Kappa styles a native select control.
            The browser owns menu behavior, keyboard input, and platform presentation.
          </p>
          <ul>
            <li>Use Native Select for short, fixed choice lists and standard form behavior.</li>
            <li>
              Use <a href="/docs/components/select">Select</a> for a fully styled Ark UI popup,
              custom placement, or richer option content.
            </li>
            <li>
              Use <a href="/docs/components/field">Field.Select</a> when Ark UI must connect the
              label, helper text, required state, and error message.
            </li>
          </ul>
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>

          <h3 id="sizes"><a class="docs-section-anchor" href="#sizes">Sizes</a></h3>
          <p>Four control densities align Native Select with Kappa inputs and buttons.</p>
          <div class="docs-component-example">
            <div class="docs-component-preview">
              <NativeSelectDocsDemo client:load variant="sizes" />
            </div>
            <CodeBlock
              code={sizesCode}
              lang="vue"
              collapsible
              revealId="native-select-sizes-code"
            />
          </div>

          <h3 id="option-groups">
            <a class="docs-section-anchor" href="#option-groups">Option Groups</a>
          </h3>
          <p>Use native option groups to name related choices.</p>
          <div class="docs-component-example">
            <div class="docs-component-preview">
              <NativeSelectDocsDemo client:load variant="groups" />
            </div>
            <CodeBlock
              code={groupsCode}
              lang="vue"
              collapsible
              revealId="native-select-groups-code"
            />
          </div>

          <h3 id="states"><a class="docs-section-anchor" href="#states">Form States</a></h3>
          <p>
            Native disabled and required behavior remains authoritative. Connect invalid controls to
            clear correction text.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview">
              <NativeSelectDocsDemo client:load variant="states" />
            </div>
            <CodeBlock
              code={statesCode}
              lang="vue"
              collapsible
              revealId="native-select-states-code"
            />
          </div>

          <h3 id="multiple"><a class="docs-section-anchor" href="#multiple">Multiple</a></h3>
          <p>
            Add <code>multiple</code> and bind an array. The native menu emits all selected values.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview">
              <NativeSelectDocsDemo client:load variant="multiple" />
            </div>
            <CodeBlock
              code={multipleCode}
              lang="vue"
              collapsible
              revealId="native-select-multiple-code"
            />
          </div>

          <h3 id="right-to-left">
            <a class="docs-section-anchor" href="#right-to-left">Right to Left</a>
          </h3>
          <p>The chevron and control padding follow the inherited writing direction.</p>
          <div class="docs-component-example">
            <div class="docs-component-preview">
              <NativeSelectDocsDemo client:load variant="rtl" />
            </div>
            <CodeBlock
              code={rtlCode}
              lang="vue"
              collapsible
              revealId="native-select-rtl-code"
            />
          </div>
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <ul>
            <li>Give every Native Select a visible Label when the layout permits it.</li>
            <li>Keep a disabled placeholder option when the first choice is not a valid value.</li>
            <li>Connect help and error text with <code>aria-describedby</code>.</li>
            <li>Use option groups only when their labels help users understand the choices.</li>
            <li>Native keyboard, touch, form, forced-color, and browser zoom behavior stays intact.</li>
          </ul>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>
          <div class="docs-api-group">
            <h3 id="native-select-api">
              <a class="docs-section-anchor" href="#native-select-api">NativeSelect</a>
            </h3>
            <p>Renders one native select. Standard select attributes pass to the same element.</p>
            <div class="docs-api-table">
              <table>
                <thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                <tbody>
                  {nativeSelectProps.map((prop) => (
                    <tr>
                      <td><code>{prop.name}</code></td>
                      <td><code>{prop.type}</code></td>
                      <td><code>{prop.defaultValue}</code></td>
                      <td>{prop.description}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
          <div class="docs-api-group">
            <h3 id="events"><a class="docs-section-anchor" href="#events">Events</a></h3>
            <div class="docs-api-table">
              <table>
                <thead><tr><th>Event</th><th>Payload</th><th>Description</th></tr></thead>
                <tbody>
                  {events.map((event) => (
                    <tr><td><code>{event.name}</code></td><td><code>{event.payload}</code></td><td>{event.description}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
          <div class="docs-api-group">
            <h3 id="data-attributes">
              <a class="docs-section-anchor" href="#data-attributes">Data Attributes</a>
            </h3>
            <div class="docs-api-table">
              <table>
                <thead><tr><th>Attribute</th><th>Value</th><th>Description</th></tr></thead>
                <tbody>
                  {dataAttributes.map((attribute) => (
                    <tr><td><code>{attribute.name}</code></td><td><code>{attribute.value}</code></td><td>{attribute.description}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
          <div class="docs-api-group">
            <h3 id="exports"><a class="docs-section-anchor" href="#exports">Exports</a></h3>
            <div class="docs-api-table">
              <table>
                <thead><tr><th>Export</th><th>Description</th></tr></thead>
                <tbody>
                  {exportsList.map((item) => (
                    <tr><td><code>{item.name}</code></td><td>{item.description}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <DocsPageNavigation currentPath={currentPath} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li><a href="#installation" data-toc-link="installation">Installation</a><ul><li><a href="#barrel" data-toc-link="barrel">Barrel</a></li><li><a href="#granular" data-toc-link="granular">Granular</a></li></ul></li>
            <li><a href="#usage" data-toc-link="usage">Usage</a></li>
            <li><a href="#composition" data-toc-link="composition">Composition</a></li>
            <li><a href="#examples" data-toc-link="examples">Examples</a><ul><li><a href="#sizes" data-toc-link="sizes">Sizes</a></li><li><a href="#option-groups" data-toc-link="option-groups">Option Groups</a></li><li><a href="#states" data-toc-link="states">Form States</a></li><li><a href="#multiple" data-toc-link="multiple">Multiple</a></li><li><a href="#right-to-left" data-toc-link="right-to-left">Right to Left</a></li></ul></li>
            <li><a href="#accessibility" data-toc-link="accessibility">Accessibility</a></li>
            <li><a href="#api-reference" data-toc-link="api-reference">API Reference</a><ul><li><a href="#native-select-api" data-toc-link="native-select-api">NativeSelect</a></li><li><a href="#events" data-toc-link="events">Events</a></li><li><a href="#data-attributes" data-toc-link="data-attributes">Data Attributes</a></li><li><a href="#exports" data-toc-link="exports">Exports</a></li></ul></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
