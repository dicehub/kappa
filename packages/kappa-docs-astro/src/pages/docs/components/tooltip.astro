---
import ArkUiDocsLink from "../../../components/ArkUiDocsLink.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import CompositionTree from "../../../components/CompositionTree.astro";
import CopyPageControls from "../../../components/CopyPageControls.vue";
import DocsPageNavigation from "../../../components/DocsPageNavigation.astro";
import TooltipDocsDemo from "../../../components/TooltipDocsDemo.vue";
import {
  barrelCode,
  compositionCode,
  contentProps,
  events,
  examples,
  exportsList,
  granularCode,
  parts,
  previewCode,
  rootProps,
  usageCode,
} from "../../../data/tooltip-docs";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import "../../../styles/docs-components.css";

const currentPath = "/docs/components/tooltip";
const description =
  "Shows a short, non-interactive label when an element receives keyboard focus or pointer hover.";
---

<DocsLayout title="Tooltip" description={description}>
  <div class="docs-page docs-page--component">
    <header class="docs-page-header">
      <div class="docs-page-header__inner">
        <div class="docs-page-header__content">
          <div class="docs-page-header__mobile-actions">
            <CopyPageControls client:only="vue" align="center" />
          </div>
          <div class="docs-page-header__title-row">
            <h1>Tooltip</h1>
            <ArkUiDocsLink />
            <div class="docs-page-header__navigation-actions">
              <div class="docs-page-header__desktop-actions"><CopyPageControls client:only="vue" /></div>
              <DocsPageNavigation currentPath={currentPath} variant="compact" />
            </div>
          </div>
          <p class="docs-page-header__lede">{description}</p>
        </div>
      </div>
    </header>

    <div class="docs-page-body">
      <article class="docs-article docs-article--component">
        <section id="preview" class="docs-section">
          <div class="docs-component-example">
            <div class="docs-component-preview">
              <TooltipDocsDemo client:only="vue" variant="preview" />
            </div>
            <CodeBlock code={previewCode} lang="vue" collapsible revealId="tooltip-preview-code" />
          </div>
        </section>

        <section id="installation" class="docs-section">
          <h2><a class="docs-section-anchor" href="#installation">Installation</a></h2>
          <p>
            Tooltip is part of the main Kappa package. Ark UI supplies hover, focus, Escape,
            described-by relationships, collision handling, and shared delay behavior.
          </p>
          <h3 id="barrel"><a class="docs-section-anchor" href="#barrel">Barrel</a></h3>
          <CodeBlock code={barrelCode} lang="javascript" />
          <h3 id="granular"><a class="docs-section-anchor" href="#granular">Granular</a></h3>
          <CodeBlock code={granularCode} lang="javascript" />
        </section>

        <section id="usage" class="docs-section">
          <h2><a class="docs-section-anchor" href="#usage">Usage</a></h2>
          <p>
            Use <code>asChild</code> on Trigger to keep the original Button, Link, or control as the
            only interactive element. Keep content short and non-interactive.
          </p>
          <div class="docs-component-example">
            <div class="docs-component-preview">
              <TooltipDocsDemo client:only="vue" variant="usage" />
            </div>
            <CodeBlock code={usageCode} lang="vue" collapsible revealId="tooltip-usage-code" />
          </div>
        </section>

        <section id="composition" class="docs-section">
          <h2><a class="docs-section-anchor" href="#composition">Composition</a></h2>
          <CompositionTree component="tooltip" />
          <p>
            Kappa follows Ark UI state and part contracts. <code>Tooltip.Content</code> adds the
            positioner, safe Vue Teleport, and default Arrow so the common composition stays small.
            Use the named parts or the arrow slot when a custom surface needs them.
          </p>
          <p>
            Kappa intentionally defaults to a top placement with an 8 px gutter. Pass Ark UI
            <code>positioning</code> options to change placement, offsets, collision behavior, or the
            fixed-position strategy.
          </p>
          <CodeBlock code={compositionCode} lang="vue" />
        </section>

        <section id="examples" class="docs-section docs-section--component-examples">
          <h2><a class="docs-section-anchor" href="#examples">Examples</a></h2>
          {
            examples.map((example) => (
              <>
                <h3 id={example.id}>
                  <a class="docs-section-anchor" href={`#${example.id}`}>{example.title}</a>
                </h3>
                <p>{example.description}</p>
                <div class="docs-component-example">
                  <div class="docs-component-preview">
                    <TooltipDocsDemo client:only="vue" variant={example.variant} />
                  </div>
                  <CodeBlock
                    code={example.code}
                    lang="vue"
                    collapsible
                    revealId={`tooltip-${example.id}-code`}
                  />
                </div>
              </>
            ))
          }
        </section>

        <section id="accessibility" class="docs-section">
          <h2><a class="docs-section-anchor" href="#accessibility">Accessibility</a></h2>
          <ul>
            <li>Pointer hover and keyboard focus open the same tooltip.</li>
            <li>Keyboard focus opens without the pointer delay. Escape closes the open tooltip.</li>
            <li>Ark UI links Trigger and Content through <code>aria-describedby</code>.</li>
            <li>Tooltip content must not contain controls, links, or information required to finish a task.</li>
            <li>Use a visible label when space permits. A tooltip does not replace an accessible name.</li>
            <li>Wrap a disabled control in a focusable element because native disabled controls cannot receive focus.</li>
            <li>Opening motion honors <code>prefers-reduced-motion</code>; forced colors keep a visible boundary.</li>
          </ul>
          <p>
            Use <a href="/docs/components/popover">Popover</a> when the floating content must accept
            input or contain actions.
          </p>
        </section>

        <section id="api-reference" class="docs-section">
          <h2><a class="docs-section-anchor" href="#api-reference">API Reference</a></h2>

          <div class="docs-api-group">
            <h3 id="root-api"><a class="docs-section-anchor" href="#root-api">Tooltip.Root</a></h3>
            <p>Owns Ark UI open state, delay, active trigger, and positioning.</p>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{rootProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>

          <div class="docs-api-group">
            <h3 id="parts-api"><a class="docs-section-anchor" href="#parts-api">Parts</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Part</th><th>Element</th><th>Description</th></tr></thead><tbody>{parts.map((part) => <tr><td><code>{part.name}</code></td><td><code>{part.element}</code></td><td>{part.description}</td></tr>)}</tbody></table></div>
          </div>

          <div class="docs-api-group">
            <h3 id="content-api"><a class="docs-section-anchor" href="#content-api">Tooltip.Content</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody>{contentProps.map((prop) => <tr><td><code>{prop.name}</code></td><td><code>{prop.type}</code></td><td><code>{prop.defaultValue}</code></td><td>{prop.description}</td></tr>)}</tbody></table></div>
          </div>

          <div class="docs-api-group">
            <h3 id="events-api"><a class="docs-section-anchor" href="#events-api">Events</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Event</th><th>Payload</th><th>Description</th></tr></thead><tbody>{events.map((event) => <tr><td><code>{event.name}</code></td><td><code>{event.payload}</code></td><td>{event.description}</td></tr>)}</tbody></table></div>
          </div>

          <div class="docs-api-group">
            <h3 id="exports"><a class="docs-section-anchor" href="#exports">Exports</a></h3>
            <div class="docs-api-table"><table><thead><tr><th>Export</th><th>Description</th></tr></thead><tbody>{exportsList.map((item) => <tr><td><code>{item.name}</code></td><td>{item.description}</td></tr>)}</tbody></table></div>
          </div>
        </section>

        <DocsPageNavigation currentPath={currentPath} />
      </article>

      <aside class="docs-page-toc" aria-label="On this page">
        <div class="docs-page-toc__inner">
          <span class="docs-page-toc__title">On this page</span>
          <ul>
            <li><a href="#installation" data-toc-link="installation">Installation</a><ul><li><a href="#barrel" data-toc-link="barrel">Barrel</a></li><li><a href="#granular" data-toc-link="granular">Granular</a></li></ul></li>
            <li><a href="#usage" data-toc-link="usage">Usage</a></li>
            <li><a href="#composition" data-toc-link="composition">Composition</a></li>
            <li><a href="#examples" data-toc-link="examples">Examples</a><ul>{examples.map((example) => <li><a href={`#${example.id}`} data-toc-link={example.id}>{example.title}</a></li>)}</ul></li>
            <li><a href="#accessibility" data-toc-link="accessibility">Accessibility</a></li>
            <li><a href="#api-reference" data-toc-link="api-reference">API Reference</a><ul><li><a href="#root-api" data-toc-link="root-api">Tooltip.Root</a></li><li><a href="#parts-api" data-toc-link="parts-api">Parts</a></li><li><a href="#content-api" data-toc-link="content-api">Tooltip.Content</a></li><li><a href="#events-api" data-toc-link="events-api">Events</a></li><li><a href="#exports" data-toc-link="exports">Exports</a></li></ul></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</DocsLayout>
