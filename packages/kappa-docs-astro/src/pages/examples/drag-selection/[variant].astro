---
import DragSelectionDocsDemo from "../../../components/DragSelectionDocsDemo.vue";
import { examples } from "../../../data/drag-selection-docs";
import "../../../styles/docs.css";

export function getStaticPaths() {
  return [
    { params: { variant: "full-screen" }, props: { title: "Asset library", demoVariant: "preview" } },
    ...examples.map(example => ({ params: { variant: example.id }, props: { title: example.title, demoVariant: example.id } })),
  ];
}

type DemoVariant = "preview" | "list" | "scrolling" | "disabled" | "click-only";
const { title, demoVariant } = Astro.props as { title: string; demoVariant: DemoVariant };
---

<!doctype html>
<html lang="en" class="kappa-docs-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <title>{title} Drag Selection — Kappa Components</title>
    <script is:inline>
      const mode = localStorage.getItem("theme") === "dark" ? "dark" : "light";
      document.documentElement.dataset.mode = mode;
      document.documentElement.dataset.kappaTheme = mode;
      document.documentElement.style.colorScheme = mode;
    </script>
  </head>
  <body><main><DragSelectionDocsDemo client:load variant={demoVariant} standalone /></main></body>
</html>

<style>body { margin: 0; } main { min-inline-size: 0; }</style>
