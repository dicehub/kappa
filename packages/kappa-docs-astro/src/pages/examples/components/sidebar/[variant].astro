---
import SidebarDocsDemo from "../../../../components/SidebarDocsDemo.vue";
import "../../../../styles/docs.css";

export function getStaticPaths() {
  return ["mobile", "full-screen-mobile"].map(variant => ({ params: { variant } }));
}
const { variant } = Astro.params;
---

<!doctype html>
<html lang="en" class="kappa-docs-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <title>{variant === "mobile" ? "Mobile Sidebar" : "Full-screen Mobile Sidebar"} — Kappa</title>
    <script is:inline>
      const mode = localStorage.getItem("theme") === "dark" ? "dark" : "light";
      document.documentElement.dataset.mode = mode;
      document.documentElement.dataset.kappaTheme = mode;
      document.documentElement.style.colorScheme = mode;
    </script>
  </head>
  <body><main><SidebarDocsDemo client:load variant={variant} standalone /></main></body>
</html>

<style>html, body { margin: 0; block-size: 100%; overflow: hidden; } main { min-inline-size: 0; }</style>
