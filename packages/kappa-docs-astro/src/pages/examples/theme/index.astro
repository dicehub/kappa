---
import "@dicehub/kappa/styles/theme-kappa.css";
import "@dicehub/kappa/styles/kappa.css";
import ThemeFixtureControls from "../../../components/ThemeFixtureControls.vue";

/**
 * Standalone fixture for the published theme and component styles. It does not
 * import documentation CSS, so a rendering or token regression here proves
 * the package does not depend on documentation aliases. Exercised by
 * `e2e/colors.spec.ts`; not part of the documentation navigation.
 */
const probes = [
  "--kappa-canvas",
  "--kappa-base",
  "--kappa-control",
  "--kappa-tint",
  "--kappa-overlay",
  "--kappa-default",
  "--kappa-strong",
  "--kappa-subtle",
  "--kappa-accent",
  "--kappa-selected-background",
  "--kappa-selected-contrast",
  "--kappa-selected-text",
  "--kappa-focus",
  "--kappa-line-strong",
  "--kappa-danger-text",
  "--kappa-danger-tint",
  "--kappa-info-tint",
];

const scopes: Array<{
  id: string;
  label: string;
  note: string;
  mode?: string;
  style?: string;
  theme?: string;
}> = [
  {
    id: "default",
    label: "Default (no attribute)",
    note: "The document root token set, which is light.",
  },
  {
    id: "explicit-light",
    label: 'Explicit light · data-kappa-theme="light"',
    note: "Canonical light scope on a section.",
    theme: "light",
  },
  {
    id: "explicit-dark",
    label: 'Explicit dark · data-kappa-theme="dark"',
    note: "Canonical dark scope on a section.",
    theme: "dark",
  },
  {
    id: "legacy-dark",
    label: 'Legacy dark · data-mode="dark"',
    note: "Compatibility attribute for pre-theme applications.",
    mode: "dark",
  },
  {
    id: "override-dark",
    label: "Consumer override on a dark scope",
    note: "Overriding --kappa-selected-background and --kappa-selected-contrast retargets pressed controls.",
    style:
      "--kappa-selected-background: #b42318; --kappa-selected-contrast: #ffffff;",
    theme: "dark",
  },
];
---

<!doctype html>
<html lang="en" data-theme-fixture>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <title>Theme fixture — Kappa</title>
  </head>
  <body>
    <main data-theme-fixture-root>
      <header>
        <h1>Kappa theme fixture</h1>
        <p>
          Standalone rendering of <code>@dicehub/kappa/styles/theme-kappa.css</code> with no
          documentation stylesheet.
        </p>
      </header>

      {
        scopes.map((scope) => (
          <section
            class="fixture__scope"
            data-theme-scope={scope.id}
            data-kappa-theme={scope.theme}
            data-mode={scope.mode}
            style={scope.style}
          >
            <h2>{scope.label}</h2>
            <p class="fixture__note">{scope.note}</p>
            <ThemeFixtureControls client:load />
            <ul class="fixture__probes">
              {probes.map((token) => (
                <li class="fixture__probe">
                  <span
                    class="fixture__probe-swatch"
                    data-theme-probe={token}
                    style={`background: var(${token})`}
                  />
                  <code>{token}</code>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <section class="fixture__scope" data-theme-scope="nested" data-kappa-theme="dark">
        <h2>Nested light scope inside a dark section</h2>
        <p class="fixture__note">
          An explicit <code>data-kappa-theme="light"</code> section keeps light values inside its
          own subtree.
        </p>
        <ThemeFixtureControls client:load />
        <div class="fixture__nested" data-kappa-theme="light" data-theme-scope="nested-light">
          <ThemeFixtureControls client:load />
          <ul class="fixture__probes">
            {probes.map((token) => (
              <li class="fixture__probe">
                <span
                  class="fixture__probe-swatch"
                  data-theme-probe={token}
                  style={`background: var(${token})`}
                />
                <code>{token}</code>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: var(--kappa-canvas);
    color: var(--kappa-default);
    font-family: ui-sans-serif, system-ui, sans-serif;
  }

  main {
    display: grid;
    max-inline-size: 60rem;
    margin-inline: auto;
    padding: 2rem 1.5rem 4rem;
    gap: 1.5rem;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

  h2 {
    margin: 0;
    font-size: 0.9375rem;
  }

  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
  }

  .fixture__scope {
    display: grid;
    padding: 1rem;
    border: 1px solid var(--kappa-line);
    border-radius: 0.75rem;
    background: var(--kappa-canvas);
    color: var(--kappa-default);
    gap: 0.75rem;
  }

  .fixture__note {
    margin: 0;
    color: var(--kappa-subtle);
    font-size: 0.75rem;
  }

  .fixture__nested {
    display: grid;
    padding: 1rem;
    border: 1px solid var(--kappa-line);
    border-radius: 0.625rem;
    gap: 0.75rem;
  }

  .fixture__probes {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
    gap: 0.5rem 0.75rem;
  }

  .fixture__probe {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--kappa-subtle);
  }

  .fixture__probe-swatch {
    inline-size: 0.875rem;
    block-size: 0.875rem;
    border: 1px solid var(--kappa-hairline);
    border-radius: 0.25rem;
  }
</style>
