---
import LoginBlocksDocsDemo from "../../../components/LoginBlocksDocsDemo.vue";
import { loginBlocks } from "../../../data/login-blocks";
import "../../../styles/docs.css";

export function getStaticPaths() {
  return loginBlocks.map(block => ({ params: { variant: block.id }, props: { block } }));
}

const { block } = Astro.props;
---

<!doctype html>
<html lang="en" class="kappa-docs-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <title>{block.title} Login — Kappa Blocks</title>
    <script is:inline>
      const mode = localStorage.getItem("theme") === "dark" ? "dark" : "light";
      document.documentElement.dataset.mode = mode;
      document.documentElement.dataset.kappaTheme = mode;
      document.documentElement.style.colorScheme = mode;
    </script>
  </head>
  <body><main><LoginBlocksDocsDemo client:load variant={block.id} standalone /></main></body>
</html>

<style>body { margin: 0; } main { min-inline-size: 0; }</style>
