---
interface Props {
  class?: string;
  decorative?: boolean;
  title?: string;
}

const { class: className = "", decorative = false, title = "Kappa" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 88 88"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role={decorative ? undefined : "img"}
  aria-label={decorative ? undefined : title}
  aria-hidden={decorative ? "true" : undefined}
  focusable="false"
>
  <path class="docs-mark__stem" d="M25 10V78" stroke="currentColor" stroke-width="8" stroke-linecap="round" />
  <path class="docs-mark__chevron" d="M65 13L28 44L65 75" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
  <circle class="docs-mark__node" cx="28" cy="44" r="3.5" fill="currentColor" />
</svg>
