{
  "name": "kappa-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @dicehub/kappa-docs-astro dev",
    "build": "pnpm -r --if-present build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node tests/blackbox/run.mjs --with-legacy",
    "test:blackbox": "node tests/blackbox/run.mjs",
    "test:deployment": "node --test \"scripts/*.test.mjs\"",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "typescript": "5.9.3"
  }
}
